From: nvidia-prolapse <nvidia-prolapse@localhost>
Subject: [PATCH] gbm_mesa: FP16 and 1010102 render targets from the wrapper

Applies to https://github.com/waydroid/android_external_minigbm
16844babfbd83d7c206ca22256257cbf26ca7de1 ("gralloc: Handle PixelFormat::R_8"),
after 0001 and 0002.

gbm_mesa_driver_init() registers render/scanout combinations only for the
8888 formats and RGB565, so HAL_PIXEL_FORMAT_RGBA_FP16 (DRM ABGR16161616F)
and RGBA_1010102 (ABGR2101010), which cros_gralloc_convert_format() maps,
fail every allocation with "Unsupported combination". An EGL driver that
offers EGL_EXT_pixel_format_float window configs then cannot get window
buffers (dEQP-EGL.functional.wide_color.window_fp16_*: the Android loader
sets RGBA_FP16 on the window, gralloc refuses usage 0xb00, eglCreateWindowSurface
fails with EGL_BAD_NATIVE_WINDOW).

Register both as render/scanout formats. They are GPU render targets only
when the wrapper allocates them itself (get_gbm_format != 0); with a wrapper
that does not, allocation fails loudly instead of falling back to minigbm's
R8 carrier layout, which no GPU renders into.

---
diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 717363d..312b622 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -81,6 +81,21 @@ static const uint32_t scanout_render_formats[] = { DRM_FORMAT_ARGB8888, DRM_FORM
 						   DRM_FORMAT_ABGR8888, DRM_FORMAT_XBGR8888,
 						   DRM_FORMAT_RGB565 };
 
+/*
+ * HAL_PIXEL_FORMAT_RGBA_FP16 / RGBA_1010102 (cros_gralloc_convert_format) as GPU render
+ * targets, offered only when the wrapper allocates them itself (get_gbm_format != 0):
+ * otherwise minigbm would lay them out as an R8 carrier, which no GPU renders into.
+ */
+static const uint32_t wrapper_render_formats[] = { DRM_FORMAT_ABGR16161616F, DRM_FORMAT_ABGR2101010 };
+
+static bool is_wrapper_render_format(uint32_t format)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(wrapper_render_formats); i++)
+		if (wrapper_render_formats[i] == format)
+			return true;
+	return false;
+}
+
 static const uint32_t texture_only_formats[] = { DRM_FORMAT_NV12, DRM_FORMAT_NV21,
 						 DRM_FORMAT_YVU420, DRM_FORMAT_YVU420_ANDROID };
 
@@ -94,6 +109,9 @@ int gbm_mesa_driver_init(struct driver *drv)
 	drv_add_combinations(drv, texture_only_formats, ARRAY_SIZE(texture_only_formats),
 			     &linear_metadata, BO_USE_TEXTURE_MASK | BO_USE_SCANOUT);
 
+	drv_add_combinations(drv, wrapper_render_formats, ARRAY_SIZE(wrapper_render_formats),
+			     &linear_metadata, BO_USE_RENDER_MASK | BO_USE_SCANOUT);
+
 	drv_add_combination(drv, DRM_FORMAT_R8, &linear_metadata, BO_USE_SW_MASK | BO_USE_LINEAR);
 
 	// Fixes android.hardware.cts.HardwareBufferTest#testCreate CTS test
@@ -335,6 +353,13 @@ int gbm_mesa_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 
 	auto wr = drv->wrapper;
 
+	if (is_wrapper_render_format(format) && wr->get_gbm_format(format) == 0) {
+		drv_loge("format %.4s is offered only as a wrapper-allocated render target, but '%s' "
+			 "does not allocate it (get_gbm_format = 0); refusing an R8-carrier layout",
+			 (const char *)&format, GBM_WRAPPER_NAME);
+		return -EINVAL;
+	}
+
 	/*
 	 * CPU access needs a mappable buffer (needs_map_stride), but it forces a
 	 * LINEAR layout only when the GPU does not also render into the buffer.
