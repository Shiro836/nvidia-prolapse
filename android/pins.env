# Pinned Android build inputs (android/provision.sh, media/vndk/build.sh, the Mesa/HAL/gralloc builds).
# Sourced by bash. Every value is a commit SHA or a sha256-checked download.

# NDK: r29 (.note.android.ident "r29 14206865").
NDK_VERSION=r29
NDK_URL=https://dl.google.com/android/repository/android-ndk-r29-linux.zip
NDK_ZIP_SHA256=4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf

# AOSP header repos (android-13 era, the image's ABI), shallow-fetched at these commits.
AOSP_BASE=https://android.googlesource.com/platform
AOSP_FMQ_SHA=e743e9f3f496ec757eda5fcd78417567cd3040f2
AOSP_FMTLIB_SHA=2408feea0803c118beaf7c627ab876788b030e9f
AOSP_FRAMEWORKS_NATIVE_SHA=22e08d27a0f593a1a4920cd90cca935ed1cc7abb
AOSP_HARDWARE_INTERFACES_SHA=ae23313a6e047383d13aa4435ec813afbfe61ebe
AOSP_HIDL_SHA=15655b575b1f1c6a00aa483b5c3a6469c2cc969e
AOSP_LIBBASE_SHA=bfc09f25369d843d67fe7929cff62af3842c9c24
AOSP_LIBHARDWARE_SHA=a85695ed3fb6308a6daa14c303218b89940e36c2
AOSP_LIBHIDL_SHA=b7e1131f4a5ba090c188126c017069a0f4fb63d6
AOSP_LIBHWBINDER_SHA=66f259a545c8b349dcf4bdfe27e3f0b04be79b13
AOSP_SYSTEM_CORE_SHA=88a4c62d2cdfb84e27ae207986429a30979cd790
# liblog for the host hidl-gen build (LineageOS mirror)
SYSTEM_LOGGING_URL=https://github.com/LineageOS/android_system_logging
SYSTEM_LOGGING_SHA=373d54e772f303c441faf2e584a2edf3601b4181

# Link-time .so stubs (system/vndk libs): from local images ($ANDROID_IMAGES, or a Waydroid install's
# images_path) or, if absent, these OTA zips: the guest image the driver targets
# (2026-10-16: lineage-20.0 20260927 GAPPS system + MAINLINE vendor; sha256 = the ota.waydro.id JSON id,
# re-checked on download).
IMG_SYSTEM_URL=https://sourceforge.net/projects/waydroid/files/images/system/lineage/waydroid_x86_64/lineage-20.0-20260927-GAPPS-waydroid_x86_64-system.zip/download
IMG_SYSTEM_SHA256=1d79df0b17ab8f79d66fd3b5f94500cc02f1abe149cf8caa391380092ede6e2a
IMG_VENDOR_URL=https://sourceforge.net/projects/waydroid/files/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip/download
IMG_VENDOR_SHA256=d911b8353f6c807b94790b1c41c67e863a9f3dcd1cf3ec0232351398235afd7a
# Second entry points to the same SourceForge files (each redirects to a mirror of its own choosing; no other host
# publishes these images). tools/fetch.py gives up a stalled or trickling mirror and tries these next.
IMG_SYSTEM_URL_ALT=https://downloads.sourceforge.net/project/waydroid/images/system/lineage/waydroid_x86_64/lineage-20.0-20260927-GAPPS-waydroid_x86_64-system.zip
IMG_VENDOR_URL_ALT=https://downloads.sourceforge.net/project/waydroid/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip
