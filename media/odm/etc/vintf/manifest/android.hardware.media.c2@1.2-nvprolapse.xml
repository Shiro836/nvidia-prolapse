<!-- Vendor Codec2 store "default" (Codec2Client lists android.hardware.media.c2@1.0::IComponentStore
     instances from the VINTF manifest; an instance named "default*" sorts first and gets
     kFlagIsVendor|kFlagIsHardwareAccelerated). ODM fragments are merged into the device manifest
     when /vendor/etc/vintf/manifest.xml exists (libvintf VintfObject.cpp:257-272, android-13.0.0_r1). -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
