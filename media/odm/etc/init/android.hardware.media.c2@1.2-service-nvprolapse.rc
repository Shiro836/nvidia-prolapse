# Vendor Codec2 HAL: NVDEC decoders (media/). Same class/user/groups/priority as
# frameworks/av media/codec2/hidl/services/android.hardware.media.c2@1.2-default-service.rc
# (android-13); the binary lives on /odm (linkerconfig "vendor" section), its libraries in
# /vendor_extra/lib64 (vendor default namespace search path).
service android-hardware-media-c2-nvprolapse /odm/bin/hw/android.hardware.media.c2@1.2-service-nvprolapse
    class hal
    user mediacodec
    group camera mediadrm drmrpc graphics
    ioprio rt 4
    task_profiles ProcessCapacityHigh
