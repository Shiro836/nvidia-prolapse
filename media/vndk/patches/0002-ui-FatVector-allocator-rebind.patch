Toolchain compat (NDK r29 libc++ static_asserts that every allocator used by std::vector
implements rebind; libc++ cannot derive it for InlineStdAllocator<T, size_t> because of the
non-type parameter). Header-only: adds a nested rebind template, no data member, no change
to layout or mangling of FatVector/Region as exported by the image's libui.so.
Applied to a copy of frameworks/native libs/ui/include at AOSP_FRAMEWORKS_NATIVE_SHA.

--- a/frameworks_native/libs/ui/include/ui/FatVector.h
+++ b/frameworks_native/libs/ui/include/ui/FatVector.h
@@ -44,6 +44,11 @@
     typedef T value_type; // needed to implement std::allocator
     typedef T* pointer;   // needed to implement std::allocator
 
+    template <class U>
+    struct rebind {
+        typedef InlineStdAllocator<U, SIZE> other;
+    };
+
     explicit InlineStdAllocator(Allocation& allocation) : mAllocation(allocation) {}
     InlineStdAllocator(const InlineStdAllocator& other) : mAllocation(other.mAllocation) {}
     ~InlineStdAllocator() {}
