#version 450
/* test/etc2-roundtrip.c: reads one (mip, layer) of an ETC2/EAC image view through a combined image sampler, as an
 * app would sample it, and writes each texel as one uint into a storage buffer: mode 0 packed RGBA8 (UNORM view),
 * mode 1 the 16-bit UNORM values r | g << 16, mode 2 the 16-bit SNORM values (two's complement) r | g << 16. Each is
 * exact for its format, so the words compare bit for bit with the CPU reference. markers[idx] = marker proves which
 * push constants the dispatch saw (the HAL's decode in between must not change them).
 * Compiled at build time: glslangValidator -V -x (Makefile). */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2DArray tex;
layout(set = 0, binding = 1, std430) buffer Out {
    uint markers[64];
    uint texels[];
} o;
layout(push_constant) uniform PC {
    int mip;
    int layer;
    uint w;
    uint h;
    uint base;
    uint idx;
    uint marker;
    uint mode;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x == 0u && p.y == 0u) o.markers[pc.idx] = pc.marker;
    if (p.x >= pc.w || p.y >= pc.h) return;
    vec4 t = texelFetch(tex, ivec3(p, pc.layer), pc.mip);
    uint v;
    if (pc.mode == 0u)
        v = packUnorm4x8(t);
    else if (pc.mode == 1u)
        v = uint(round(t.r * 65535.0)) | (uint(round(t.g * 65535.0)) << 16);
    else
        v = (uint(int(round(t.r * 32767.0))) & 0xffffu) | ((uint(int(round(t.g * 32767.0))) & 0xffffu) << 16);
    o.texels[pc.base + p.y * pc.w + p.x] = v;
}
