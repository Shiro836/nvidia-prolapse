#version 450
/* test/astc-roundtrip.c: reads one (mip, layer) of an ASTC image view through a combined image sampler, as an
 * app would sample it, and writes the texels as packed RGBA8 into a storage buffer. markers[idx] = marker
 * proves which push constants the dispatch saw (the HAL's ASTC decode in between must not change them).
 * Compiled at build time: glslangValidator -V -x (Makefile). */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2DArray tex;
layout(set = 0, binding = 1, std430) buffer Out {
    uint markers[64];
    uint texels[];
} o;
layout(push_constant) uniform PC {
    int mip;
    int layer;
    uint w;
    uint h;
    uint base;
    uint idx;
    uint marker;
} pc;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x == 0u && p.y == 0u) o.markers[pc.idx] = pc.marker;
    if (p.x >= pc.w || p.y >= pc.h) return;
    o.texels[pc.base + p.y * pc.w + p.x] = packUnorm4x8(texelFetch(tex, ivec3(p, pc.layer), pc.mip));
}
