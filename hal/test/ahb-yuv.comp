#version 450
// ahb-yuv: sample a YUV AHB image through its immutable Ycbcr-conversion sampler at every luma texel
// centre and store the converted RGBA as floats (no output quantisation; the test compares against a CPU
// reference of the Vulkan spec's conversion).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(std430, set = 0, binding = 1) writeonly buffer Out { vec4 px[]; };
layout(push_constant) uniform PC { uvec2 size; } pc;
void main() {
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= pc.size.x || g.y >= pc.size.y) return;
    px[g.y * pc.size.x + g.x] = texture(tex, (vec2(g) + 0.5) / vec2(pc.size));
}
