#version 450
/* ETC2 / EAC decoder of the HAL's compressed-format emulation (src/astc.c): one invocation per texel.
 *
 * Written from the Khronos Data Format Specification 1.3, chapter "ETC2 Compressed Texture Image Formats"
 * (sections "Format RGB ETC2", "Format RGB ETC2 with punchthrough alpha", "Format RGBA ETC2", "Format Unsigned
 * R11 EAC", "Format Signed R11 EAC", "Format Unsigned RG11 EAC", "Format Signed RG11 EAC"; the sRGB variants
 * decode to the same bytes, the sampler applies the transfer function). The output is bit-exact against Mesa's
 * CPU decoder (src/mesa/main/texcompress_etc.c, _mesa_unpack_etc2_format), which test/etc2-roundtrip.c uses as
 * its reference: ETC2 colour/alpha as 8-bit values, R11/RG11 extended to 16 bits by bit replication of the 11-bit
 * value (of its magnitude for signed values; the specifications allow any extension that keeps at least 11 bits).
 *
 * Inputs: the block image (R32G32_UINT for 64-bit blocks, R32G32B32A32_UINT for 128-bit blocks; one texel per
 * 4x4 block, the block's bytes in memory order, so .x holds bytes 0-3 little-endian) and the decoded image as an
 * unsigned-integer storage view (R8G8B8A8_UINT, R16_UINT or R16G16_UINT) written without a format qualifier
 * (shaderStorageImageWriteWithoutFormat). Push constants: the texel rectangle [start, end) of the mip level,
 * start block-aligned; the dispatch's z is the layer within the views.
 *
 * Compiled at build time: glslangValidator -V -S comp -x (Makefile, out/gen/etc2_spv.h). */
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/* 0 RGB8, 1 RGB8 + punchthrough alpha (RGB8A1), 2 RGBA8 (EAC alpha + RGB8), 3 R11 EAC, 4 RG11 EAC */
layout(constant_id = 0) const uint KIND = 0u;
/* signed R11/RG11 */
layout(constant_id = 1) const bool SIGNED = false;

layout(set = 0, binding = 0) uniform writeonly uimage2DArray dst;
layout(set = 0, binding = 1) uniform utexture2DArray src;

layout(push_constant) uniform PC {
    ivec2 start;
    ivec2 end;
} pc;

/* the block's 64-bit words are big-endian: bit 63 is the most significant bit of byte 0 */
uint bswap(uint x) {
    return (x << 24) | ((x & 0xff00u) << 8) | ((x >> 8) & 0xff00u) | (x >> 24);
}

/* "Format RGB ETC2", individual/differential modes: intensity modifier table, codeword x pixel index */
const int ETC1_MOD[32] = int[32](2, 8, -2, -8, 5, 17, -5, -17, 9, 29, -9, -29, 13, 42, -13, -42,
                                 18, 60, -18, -60, 24, 80, -24, -80, 33, 106, -33, -106, 47, 183, -47, -183);
/* T and H modes: distance table */
const int DIST[8] = int[8](3, 6, 11, 16, 23, 32, 41, 64);
/* "Format RGBA ETC2" / EAC: the 16 modifier tables x 8 pixel indices */
const int EAC_MOD[128] = int[128](
    -3, -6, -9, -15, 2, 5, 8, 14,  -3, -7, -10, -13, 2, 6, 9, 12,  -2, -5, -8, -13, 1, 4, 7, 12,
    -2, -4, -6, -13, 1, 3, 5, 12,  -3, -6, -8, -12, 2, 5, 7, 11,  -3, -7, -9, -11, 2, 6, 8, 10,
    -4, -7, -8, -11, 3, 6, 7, 10,  -3, -5, -8, -11, 2, 4, 7, 10,  -2, -6, -8, -10, 1, 5, 7, 9,
    -2, -5, -8, -10, 1, 4, 7, 9,  -2, -4, -8, -10, 1, 3, 7, 9,  -2, -5, -7, -10, 1, 4, 6, 9,
    -3, -4, -7, -10, 2, 3, 6, 9,  -1, -2, -3, -10, 0, 1, 2, 9,  -4, -6, -8, -9, 3, 5, 7, 8,
    -3, -5, -7, -9, 2, 4, 6, 8);

/* bit replication of an n-bit component to 8 bits */
int ext4(int v) { return (v << 4) | v; }
int ext5(int v) { return (v << 3) | (v >> 2); }
int ext6(int v) { return (v << 2) | (v >> 4); }
int ext7(int v) { return (v << 1) | (v >> 6); }
/* a 3-bit two's-complement delta */
int sext3(int v) { return v >= 4 ? v - 8 : v; }

/* "Format RGB ETC2" (punch = false) and "Format RGB ETC2 with punchthrough alpha" (punch = true): texel t of the
 * 64-bit block hi:lo. Returns RGBA8; a transparent punchthrough texel is (0, 0, 0, 0). */
uvec4 etc2_rgb(uint hi, uint lo, ivec2 t, bool punch) {
    const int s0 = int(hi >> 24), s1 = int(hi >> 16) & 0xff, s2 = int(hi >> 8) & 0xff, s3 = int(hi) & 0xff;
    /* pixel index: MSB in bits 16..31, LSB in bits 0..15 of the low word, column-major */
    const int bit = t.y + t.x * 4;
    const int idx = int(((lo >> (bit + 15)) & 2u) | ((lo >> bit) & 1u));
    /* bit 33: "diff" bit for RGB ETC2, "opaque" bit for punchthrough alpha (which has no individual mode) */
    const bool diff = (s3 & 2) != 0;
    const bool opaque = !punch || diff;

    if (punch || diff) {
        const int r = (s0 >> 3) + sext3(s0 & 7), g = (s1 >> 3) + sext3(s1 & 7), b = (s2 >> 3) + sext3(s2 & 7);
        if (r < 0 || r > 31) {
            /* T mode */
            const ivec3 c1 = ivec3(ext4(((s0 >> 1) & 0xc) | (s0 & 3)), ext4(s1 >> 4), ext4(s1 & 15));
            const ivec3 c2 = ivec3(ext4(s2 >> 4), ext4(s2 & 15), ext4(s3 >> 4));
            const int d = DIST[((s3 >> 1) & 6) | (s3 & 1)];
            if (!opaque && idx == 2) return uvec4(0u);
            const ivec3 p = idx == 0 ? c1 : idx == 1 ? c2 + d : idx == 2 ? c2 : c2 - d;
            return uvec4(clamp(p, 0, 255), 255);
        }
        if (g < 0 || g > 31) {
            /* H mode */
            const ivec3 c1 = ivec3(ext4((s0 >> 3) & 15), ext4(((s0 & 7) << 1) | ((s1 >> 4) & 1)),
                                   ext4((s1 & 8) | ((s1 & 3) << 1) | (s2 >> 7)));
            const ivec3 c2 = ivec3(ext4((s2 >> 3) & 15), ext4(((s2 & 7) << 1) | (s3 >> 7)), ext4((s3 >> 3) & 15));
            const int v1 = (c1.r << 16) | (c1.g << 8) | c1.b, v2 = (c2.r << 16) | (c2.g << 8) | c2.b;
            const int d = DIST[(s3 & 4) | ((s3 & 1) << 1) | (v1 >= v2 ? 1 : 0)];
            if (!opaque && idx == 2) return uvec4(0u);
            const ivec3 p = idx == 0 ? c1 + d : idx == 1 ? c1 - d : idx == 2 ? c2 + d : c2 - d;
            return uvec4(clamp(p, 0, 255), 255);
        }
        if (b < 0 || b > 31) {
            /* planar mode: always opaque */
            const int s4 = int(lo >> 24), s5 = int(lo >> 16) & 0xff, s6 = int(lo >> 8) & 0xff, s7 = int(lo) & 0xff;
            const ivec3 o = ivec3(ext6((s0 >> 1) & 63), ext7(((s0 & 1) << 6) | ((s1 >> 1) & 63)),
                                  ext6(((s1 & 1) << 5) | (s2 & 0x18) | ((s2 & 3) << 1) | (s3 >> 7)));
            const ivec3 h = ivec3(ext6(((s3 & 0x7c) >> 1) | (s3 & 1)), ext7((s4 >> 1) & 0x7f),
                                  ext6(((s4 & 1) << 5) | (s5 >> 3)));
            const ivec3 v = ivec3(ext6(((s5 & 7) << 3) | (s6 >> 5)), ext7(((s6 & 0x1f) << 2) | (s7 >> 6)),
                                  ext6(s7 & 0x3f));
            return uvec4(clamp((t.x * (h - o) + t.y * (v - o) + 4 * o + 2) >> 2, 0, 255), 255);
        }
    }
    /* individual or differential mode (punchthrough: always differential): two sub-blocks, side by side or (flip
     * bit) on top of each other */
    const bool second = (s3 & 1) != 0 ? t.y >= 2 : t.x >= 2;
    ivec3 base;
    if (punch || diff)
        base = second ? ivec3(ext5((s0 >> 3) + sext3(s0 & 7)), ext5((s1 >> 3) + sext3(s1 & 7)),
                              ext5((s2 >> 3) + sext3(s2 & 7)))
                      : ivec3(ext5(s0 >> 3), ext5(s1 >> 3), ext5(s2 >> 3));
    else
        base = second ? ivec3(ext4(s0 & 15), ext4(s1 & 15), ext4(s2 & 15))
                      : ivec3(ext4(s0 >> 4), ext4(s1 >> 4), ext4(s2 >> 4));
    const int table = second ? (s3 >> 2) & 7 : (s3 >> 5) & 7;
    int m = ETC1_MOD[table * 4 + idx];
    if (!opaque) {
        /* punchthrough, opaque bit 0: index 2 is transparent black, index 0 has modifier 0 */
        if (idx == 2) return uvec4(0u);
        if (idx == 0) m = 0;
    }
    return uvec4(clamp(base + m, 0, 255), 255);
}

/* the 3-bit index of texel t in the 48 index bits of an EAC block (bytes 2-7), column-major from the MSB */
int eac_index(uint hi, uint lo, ivec2 t) {
    const int bit = ((3 - t.y) + (3 - t.x) * 4) * 3;
    uint v;
    if (bit >= 32)
        v = (hi & 0xffffu) >> (bit - 32);
    else if (bit > 29)
        v = (lo >> bit) | (hi << (32 - bit));
    else
        v = lo >> bit;
    return int(v & 7u);
}

/* "Format RGBA ETC2": the alpha block */
uint eac_alpha8(uint hi, uint lo, ivec2 t) {
    const int base = int(hi >> 24), mult = int(hi >> 20) & 15, table = int(hi >> 16) & 15;
    return uint(clamp(base + EAC_MOD[table * 8 + eac_index(hi, lo, t)] * mult, 0, 255));
}

/* "Format Unsigned/Signed R11 EAC": one channel, as the 16-bit UNORM/SNORM value (low 16 bits of the result) */
uint eac_r11(uint hi, uint lo, ivec2 t) {
    const int base = int(hi >> 24), mult = int(hi >> 20) & 15, table = int(hi >> 16) & 15;
    const int m = EAC_MOD[table * 8 + eac_index(hi, lo, t)];
    if (!SIGNED) {
        /* multiplier 0 means 1/8 */
        const int c = clamp(base * 8 + 4 + (mult != 0 ? m * mult * 8 : m), 0, 2047);
        return uint((c << 5) | (c >> 6));
    }
    /* base codeword as a two's-complement byte; -128 is treated as -127 */
    const int sb = max(base >= 128 ? base - 256 : base, -127);
    const int c = clamp(sb * 8 + (mult != 0 ? m * mult * 8 : m), -1023, 1023);
    const int a = abs(c), e = (a << 5) | (a >> 5);
    return uint(c < 0 ? -e : e) & 0xffffu;
}

void main() {
    const ivec2 p = pc.start + ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.end))) return;
    const int layer = int(gl_GlobalInvocationID.z);
    const uvec4 w = texelFetch(src, ivec3(p >> 2, layer), 0);
    const ivec2 t = p & 3;
    uvec4 o;
    if (KIND == 0u)
        o = etc2_rgb(bswap(w.x), bswap(w.y), t, false);
    else if (KIND == 1u)
        o = etc2_rgb(bswap(w.x), bswap(w.y), t, true);
    else if (KIND == 2u)
        o = uvec4(etc2_rgb(bswap(w.z), bswap(w.w), t, false).rgb, eac_alpha8(bswap(w.x), bswap(w.y), t));
    else if (KIND == 3u)
        o = uvec4(eac_r11(bswap(w.x), bswap(w.y), t), 0u, 0u, 0u);
    else
        o = uvec4(eac_r11(bswap(w.x), bswap(w.y), t), eac_r11(bswap(w.z), bswap(w.w), t), 0u, 0u);
    imageStore(dst, ivec3(p, layer), o);
}
