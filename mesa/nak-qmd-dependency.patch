 }
+
+/// The dependency layout of the device's QMDs and the QMD's words.  The
+/// proprietary driver orders compute work through QMD dependencies when the
+/// compute class is above 0xc6bf, outside GA100 (libnvidia-eglcore.so
+/// 615.78.08, ELF 0xd32f42 / ELF 0xd33302 / ELF 0xd33328): AMPERE_COMPUTE_B,
+/// ADA_COMPUTE_A, HOPPER_COMPUTE_A, BLACKWELL_COMPUTE_A, BLACKWELL_COMPUTE_B.
+/// Any other class aborts.
+fn dep_qmd<'a>(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+) -> (&'static qmd_dep::Layout, &'a mut [u32]) {
+    let layout = match dev.cls_compute {
+        clc7c0::AMPERE_COMPUTE_B | clc9c0::ADA_COMPUTE_A => {
+            assert!(qmd_size == size_of::<Qmd3_0>());
+            &qmd_dep::v3::LAYOUT
+        }
+        clcbc0::HOPPER_COMPUTE_A => {
+            assert!(qmd_size == size_of::<Qmd4_0>());
+            &qmd_dep::v4::LAYOUT
+        }
+        clcdc0::BLACKWELL_COMPUTE_A | clcec0::BLACKWELL_COMPUTE_B => {
+            assert!(qmd_size == size_of::<Qmd5_0>());
+            &qmd_dep::v5::LAYOUT
+        }
+        _ => panic!(
+            "QMD dependencies need AMPERE_COMPUTE_B..BLACKWELL_COMPUTE_B"
+        ),
+    };
+    assert!(!qmd.is_null());
+    let words = unsafe {
+        std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4)
+    };
+    (layout, words)
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_empty_grid(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+) {
+    // Keep everything of the template and only set CTA 1x1x1 / grid 0,
+    // as the proprietary driver builds its empty QMDs (ELF 0xd34709, one
+    // arm per layout).
+    let (_, words) = dep_qmd(dev, qmd, qmd_size);
+    if dev.cls_compute >= clcdc0::BLACKWELL_COMPUTE_A {
+        let mut q = Qmd5_0::from_words(words);
+        q.set_global_size(0, 0, 0);
+        q.set_local_size(1, 1, 1);
+        words.copy_from_slice(&q.qmd_words());
+    } else if dev.cls_compute >= clcbc0::HOPPER_COMPUTE_A {
+        let mut q = Qmd4_0::from_words(words);
+        q.set_global_size(0, 0, 0);
+        q.set_local_size(1, 1, 1);
+        words.copy_from_slice(&q.qmd_words());
+    } else {
+        let mut q = Qmd3_0::from_words(words);
+        q.set_global_size(0, 0, 0);
+        q.set_local_size(1, 1, 1);
+        words.copy_from_slice(&q.qmd_words());
+    }
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_dependence_counter(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    counter: u32,
+) {
+    let (l, words) = dep_qmd(dev, qmd, qmd_size);
+    let counter = u16::try_from(counter)
+        .expect("QMD dependence counter exceeds the 16-bit field");
+    let mut bv = QMDBitView::new(words);
+    bv.set_field(l.counter.clone(), counter);
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_dependent_qmd(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    slot: u32,
+    dep_addr: u64,
+) {
+    assert!(slot < 2);
+    assert!(dep_addr % 256 == 0);
+    let (l, words) = dep_qmd(dev, qmd, qmd_size);
+    let i = slot as usize;
+    let mut bv = QMDBitView::new(words);
+    bv.set_field(l.enable[i].clone(), 1_u32);
+    bv.set_field(l.action[i].clone(), l.action_decrement);
+    bv.set_field(l.prefetch[i].clone(), 1_u32);
+    bv.set_field(
+        l.pointer[i].clone(),
+        u32::try_from(dep_addr >> 8).unwrap(),
+    );
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_dependent_qmd_enabled(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    slot: u32,
+) -> bool {
+    assert!(slot < 2);
+    let (l, words) = dep_qmd(dev, qmd, qmd_size);
+    let bv = QMDBitView::new(words);
+    bv.get_bit_range_u64(l.enable[slot as usize].clone()) != 0
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_invalidates(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    texture_data: bool,
+    shader_data: bool,
+    shader_constant: bool,
+) {
+    let (l, words) = dep_qmd(dev, qmd, qmd_size);
+    let mut bv = QMDBitView::new(words);
+    if texture_data {
+        bv.set_field(l.inval_texture_data.clone(), 1_u32);
+    }
+    if shader_data {
+        bv.set_field(l.inval_shader_data.clone(), 1_u32);
+    }
+    if shader_constant {
+        bv.set_field(l.inval_shader_constant.clone(), 1_u32);
+    }
+}
