 use qmd_5_0::Qmd5_0;
 
+/// Where a QMD layout keeps the fields NVIDIA's driver
+/// (libnvidia-eglcore.so 615.78.08) writes to order compute work through QMD
+/// dependencies: DEPENDENCE_COUNTER (ELF 0xd32f60), DEPENDENT_QMD{0,1}
+/// enable / action / prefetch / pointer (ELF 0xd33340, ELF 0xd334a0) and the
+/// per-QMD cache invalidates (ELF 0xd341b0).  Those writers pick the layout
+/// from the compute class: AMPERE_COMPUTE_B and ADA_COMPUTE_A share one,
+/// HOPPER_COMPUTE_A and BLACKWELL_COMPUTE_A another, BLACKWELL_COMPUTE_B a
+/// third.  NAK fills a V05_00 QMD on Blackwell A, so its fields follow
+/// clcdc0qmd.h's V05_00 here, which equal clcec0qmd.h's.
+mod qmd_dep {
+    use std::ops::Range;
+
+    pub struct Layout {
+        pub counter: Range<usize>,
+        pub enable: [Range<usize>; 2],
+        pub action: [Range<usize>; 2],
+        pub prefetch: [Range<usize>; 2],
+        pub pointer: [Range<usize>; 2],
+        pub action_decrement: u32,
+        pub inval_texture_data: Range<usize>,
+        pub inval_shader_data: Range<usize>,
+        pub inval_shader_constant: Range<usize>,
+    }
+
+    /// QMD V03_00 (clc7c0qmd.h, the same bits in clc9c0qmd.h).  The second
+    /// dependent QMD's pointer has no name of its own in the header: the
+    /// proprietary driver stores it in QMD word 9 (ELF 0xd335d5,
+    /// `mov %esi,0x24(%rax)` in the V03 arm of ELF 0xd334a0), the bits the
+    /// header calls CIRCULAR_QUEUE_ADDR_LOWER, a field grid QMDs do not use.
+    pub mod v3 {
+        use super::Layout;
+        use nvidia_headers::classes::clc7c0::qmd::*;
+
+        pub const LAYOUT: Layout = Layout {
+            counter: QMDV03_00_DEPENDENCE_COUNTER,
+            enable: [
+                QMDV03_00_DEPENDENT_QMD0_ENABLE,
+                QMDV03_00_DEPENDENT_QMD1_ENABLE,
+            ],
+            action: [
+                QMDV03_00_DEPENDENT_QMD0_ACTION,
+                QMDV03_00_DEPENDENT_QMD1_ACTION,
+            ],
+            prefetch: [
+                QMDV03_00_DEPENDENT_QMD0_PREFETCH,
+                QMDV03_00_DEPENDENT_QMD1_PREFETCH,
+            ],
+            pointer: [
+                QMDV03_00_DEPENDENT_QMD0_POINTER,
+                QMDV03_00_CIRCULAR_QUEUE_ADDR_LOWER,
+            ],
+            action_decrement:
+                QMDV03_00_DEPENDENT_QMD0_ACTION_QMD_DECREMENT_DEPENDENCE,
+            inval_texture_data: QMDV03_00_INVALIDATE_TEXTURE_DATA_CACHE,
+            inval_shader_data: QMDV03_00_INVALIDATE_SHADER_DATA_CACHE,
+            inval_shader_constant: QMDV03_00_INVALIDATE_SHADER_CONSTANT_CACHE,
+        };
+    }
+
+    /// QMD V04_00 (clcbc0qmd.h).
+    pub mod v4 {
+        use super::Layout;
+        use nvidia_headers::classes::clcbc0::qmd::*;
+
+        pub const LAYOUT: Layout = Layout {
+            counter: QMDV04_00_DEPENDENCE_COUNTER,
+            enable: [
+                QMDV04_00_DEPENDENT_QMD_ENABLE(0),
+                QMDV04_00_DEPENDENT_QMD_ENABLE(1),
+            ],
+            action: [
+                QMDV04_00_DEPENDENT_QMD_ACTION(0),
+                QMDV04_00_DEPENDENT_QMD_ACTION(1),
+            ],
+            prefetch: [
+                QMDV04_00_DEPENDENT_QMD_PREFETCH(0),
+                QMDV04_00_DEPENDENT_QMD_PREFETCH(1),
+            ],
+            pointer: [
+                QMDV04_00_DEPENDENT_QMD0_POINTER,
+                QMDV04_00_DEPENDENT_QMD1_POINTER,
+            ],
+            action_decrement:
+                QMDV04_00_DEPENDENT_QMD_ACTION_QMD_DECREMENT_DEPENDENCE,
+            inval_texture_data: QMDV04_00_INVALIDATE_TEXTURE_DATA_CACHE,
+            inval_shader_data: QMDV04_00_INVALIDATE_SHADER_DATA_CACHE,
+            inval_shader_constant: QMDV04_00_INVALIDATE_SHADER_CONSTANT_CACHE,
+        };
+    }
+
+    /// QMD V05_00 (clcdc0qmd.h; clcec0qmd.h has the same bits).
+    pub mod v5 {
+        use super::Layout;
+        use nvidia_headers::classes::clcdc0::qmd::*;
+
+        pub const LAYOUT: Layout = Layout {
+            counter: QMDV05_00_DEPENDENCE_COUNTER,
+            enable: [
+                QMDV05_00_DEPENDENT_QMD_ENABLE(0),
+                QMDV05_00_DEPENDENT_QMD_ENABLE(1),
+            ],
+            action: [
+                QMDV05_00_DEPENDENT_QMD_ACTION(0),
+                QMDV05_00_DEPENDENT_QMD_ACTION(1),
+            ],
+            prefetch: [
+                QMDV05_00_DEPENDENT_QMD_PREFETCH(0),
+                QMDV05_00_DEPENDENT_QMD_PREFETCH(1),
+            ],
+            pointer: [
+                QMDV05_00_DEPENDENT_QMD_POINTER(0),
+                QMDV05_00_DEPENDENT_QMD_POINTER(1),
+            ],
+            action_decrement:
+                QMDV05_00_DEPENDENT_QMD_ACTION_QMD_DECREMENT_DEPENDENCE,
+            inval_texture_data: QMDV05_00_INVALIDATE_TEXTURE_DATA_CACHE,
+            inval_shader_data: QMDV05_00_INVALIDATE_SHADER_DATA_CACHE,
+            inval_shader_constant: QMDV05_00_INVALIDATE_SHADER_CONSTANT_CACHE,
+        };
+    }
+}
