 fn fill_qmd<Q: QMD>(
     dev: &nv_device_info,
     info: &nak_shader_info,
@@ -832,3 +985,137 @@ pub extern "C" fn nak_get_qmd_cbuf_desc_layout(
         panic!("Unsupported shader model");
