+/* Compute layouts on a device whose compute class has no MME (before
+ * AMPERE_COMPUTE_B) end the preprocess buffer with a 64-bit total of the
+ * compute-shader invocations the process shader generated: a compute-only
+ * queue there counts them without NVK's macros (nvk_cmd_buffer_compute_has_mme).
+ */
+static bool
+nvk_dgc_has_cs_inv_total(const struct nvk_physical_device *pdev,
+                         const struct nvk_indirect_commands_layout *layout)
+{
+   return pdev->info.cls_compute < AMPERE_COMPUTE_B &&
+          (layout->stages & VK_SHADER_STAGE_COMPUTE_BIT);
+}
