+/* A compute-only queue without MME (nvk_cmd_buffer_compute_has_mme) and
+ * without a copy engine: the 32-bit condition reaches operand A through an
+ * inline-to-memory write whose data word the host fetches from the condition
+ * buffer as a one-word GPFIFO segment, the way the proprietary driver feeds
+ * indirect-dispatch sizes on its Turing and Volta compute queues
+ * (libnvidia-eglcore.so 615.71.09 / 580.178.04, push-buffer capture).  The
+ * compute class's own render enable then compares the operands; the global
+ * render enable does not stop launches on a channel without 3D.
+ */
+static void
+nvk_cmd_begin_cond_render_inline_to_memory(struct nvk_cmd_buffer *cmd,
+                                           const VkConditionalRenderingBeginInfo2EXT *pConditionalRenderingBegin)
+{
+   const uint64_t addr = pConditionalRenderingBegin->addressRange.address;
+   bool inverted = pConditionalRenderingBegin->flags &
+      VK_CONDITIONAL_RENDERING_INVERTED_BIT_EXT;
+
+   /* Same operand layout as nvk_cmd_begin_cond_render_copy_engine(): only
+    * the low word of operand A is ever written.
+    */
+   if (cmd->cond_render_mem == NULL) {
+      VkResult result = nvk_cmd_buffer_alloc_mem(cmd, false,
+                                                 &cmd->cond_render_mem);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+      assert(cmd->cond_render_mem->mem->size_B > 32);
+      memset(cmd->cond_render_mem->mem->map, 0x00, 32);
+   }
+   const uint64_t tmp_addr = cmd->cond_render_mem->mem->va->addr;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
+   P_MTHD(p, NVA0C0, LINE_LENGTH_IN);
+   P_NVA0C0_LINE_LENGTH_IN(p, 4);
+   P_NVA0C0_LINE_COUNT(p, 1);
+   P_NVA0C0_OFFSET_OUT_UPPER(p, tmp_addr >> 32);
+   P_NVA0C0_OFFSET_OUT(p, tmp_addr);
+   P_IMMD(p, NVA0C0, LAUNCH_DMA, {
+      .dst_memory_layout = DST_MEMORY_LAYOUT_PITCH,
+      .sysmembar_disable = SYSMEMBAR_DISABLE_TRUE,
+   });
+   P_0INC(p, NVA0C0, LOAD_INLINE_DATA);
+   nv_push_update_count(p, 1);
+   nvk_cmd_buffer_push_indirect(cmd, addr, 4);
+
+   /* The proprietary driver's internal-launch form waits for its operand
+    * (host ACQ_CIRC_GEQ on the launch counter) before SET_RENDER_ENABLE_C;
+    * the write above is waited for the same way here.
+    */
+   p = nvk_cmd_buffer_push(cmd, 6);
+   P_IMMD(p, NVA0C0, WAIT_FOR_IDLE, 0);
+   P_MTHD(p, NVA0C0, SET_RENDER_ENABLE_A);
+   P_NVA0C0_SET_RENDER_ENABLE_A(p, tmp_addr >> 32);
+   P_NVA0C0_SET_RENDER_ENABLE_B(p, tmp_addr);
+   P_NVA0C0_SET_RENDER_ENABLE_C(p, inverted ? MODE_RENDER_IF_EQUAL
+                                            : MODE_RENDER_IF_NOT_EQUAL);
+}
