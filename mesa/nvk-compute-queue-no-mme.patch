+/* Compute-shader invocations on a compute class without MME.
+ *
+ * The proprietary driver counts them the same way on its Turing and Volta
+ * compute queues (libnvidia-eglcore.so 615.71.09 / 580.178.04, push-buffer
+ * capture): vkCmdBeginQuery zeroes the query and a 64-bit accumulator of the
+ * command buffer, every indirect dispatch launches a one-thread internal
+ * program with (indirect address, accumulator, local size) and
+ * vkCmdEndQuery one with (query, accumulator, invocations counted on the
+ * CPU).  Here the end waits for the indirect contributions first.
+ */
+
+struct nvk_cs_inv_push {
+   uint64_t dst;
+   uint64_t src;
+   uint64_t add;
+   uint32_t op;
+   uint32_t pad;
+};
+
+static nir_shader *
+build_cs_invocations_shader(void)
+{
+   nir_builder build =
+      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, NULL,
+                                     "nvk-meta-cs-invocations");
+   nir_builder *b = &build;
+
+   struct glsl_struct_field push_fields[] = {
+      { .type = glsl_uint64_t_type(), .name = "dst", .offset = 0 },
+      { .type = glsl_uint64_t_type(), .name = "src", .offset = 8 },
+      { .type = glsl_uint64_t_type(), .name = "add", .offset = 16 },
+      { .type = glsl_uint_type(), .name = "op", .offset = 24 },
+   };
+   const struct glsl_type *push_iface_type =
+      glsl_interface_type(push_fields, ARRAY_SIZE(push_fields),
+                          GLSL_INTERFACE_PACKING_STD140,
+                          false /* row_major */, "push");
+   nir_variable *push = nir_variable_create(b->shader, nir_var_mem_push_const,
+                                            push_iface_type, "push");
+
+   b->shader->info.workgroup_size[0] = 1;
+
+   nir_def *dst = load_struct_var(b, push, 0);
+   nir_def *src = load_struct_var(b, push, 1);
+   nir_def *add = load_struct_var(b, push, 2);
+   nir_def *op = load_struct_var(b, push, 3);
+
+   /* Written by earlier work on any SM: read around the L1. */
+   nir_push_if(b, nir_ieq_imm(b, op, NVK_CS_INV_OP_INDIRECT));
+   {
+      nir_def *size = nir_load_global(b, 3, 32, src, .align_mul = 4,
+                                      .access = ACCESS_COHERENT);
+      nir_def *count = nir_imul_2x32_64(b, nir_channel(b, size, 0),
+                                        nir_channel(b, size, 1));
+      count = nir_imul(b, count, nir_u2u64(b, nir_channel(b, size, 2)));
+      count = nir_imul(b, count, add);
+      nir_global_atomic(b, 64, dst, count, .atomic_op = nir_atomic_op_iadd);
+   }
+   nir_push_else(b, NULL);
+   {
+      nir_def *sum = nir_iadd(b, nir_load_global(b, 1, 64, src,
+                                                  .align_mul = 8,
+                                                  .access = ACCESS_COHERENT),
+                              add);
+      nir_push_if(b, nir_ieq_imm(b, op, NVK_CS_INV_OP_ADD));
+      {
+         nir_global_atomic(b, 64, dst, sum, .atomic_op = nir_atomic_op_iadd);
+      }
+      nir_push_else(b, NULL);
+      {
+         nir_store_global(b, sum, dst, .align_mul = 8,
+                          .access = ACCESS_COHERENT);
+      }
+      nir_pop_if(b, NULL);
+   }
+   nir_pop_if(b, NULL);
+
+   return build.shader;
+}
+
+static VkResult
+get_cs_invocations_shader(struct nvk_device *dev,
+                          struct nvk_shader **shader_out)
+{
+   struct nvk_shader *shader = p_atomic_read(&dev->cs_invocations);
+   if (shader != NULL) {
+      *shader_out = shader;
+      return VK_SUCCESS;
+   }
+
+   nir_shader *nir = build_cs_invocations_shader();
+   VkResult result = nvk_compile_nir_shader(dev, nir, &dev->vk.alloc, &shader);
+   if (result != VK_SUCCESS)
+      return result;
+
+   *shader_out = atomic_set_or_destroy_shader(dev, &dev->cs_invocations,
+                                              shader, &dev->vk.alloc);
+
+   return VK_SUCCESS;
+}
+
+static void
+nvk_cmd_cs_inv_dispatch(struct nvk_cmd_buffer *cmd, uint64_t dst,
+                        uint64_t src, uint64_t add, enum nvk_cs_inv_op op)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   struct nvk_shader *shader;
+   VkResult result = get_cs_invocations_shader(dev, &shader);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   /* The operands come from earlier internal launches and dispatches. */
+   if (op != NVK_CS_INV_OP_INDIRECT) {
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+      P_IMMD(p, NVA0C0, WAIT_FOR_IDLE, 0);
+   }
+
+   const struct nvk_cs_inv_push push = {
+      .dst = dst,
+      .src = src,
+      .add = add,
+      .op = op,
+   };
+   nvk_cmd_dispatch_shader(cmd, shader, &push, sizeof(push), 1, 1, 1);
+}
+
+/* The command buffer's accumulator, zeroed at this point of its stream. */
+static uint64_t
+nvk_cmd_cs_inv_reset_acc(struct nvk_cmd_buffer *cmd)
+{
+   if (cmd->cs_inv.acc_addr == 0) {
+      void *map;
+      VkResult result = nvk_cmd_buffer_upload_alloc(cmd, 8, 8,
+                                                    &cmd->cs_inv.acc_addr,
+                                                    &map);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return 0;
+      }
+   }
+   nvk_cmd_cs_invocations_zero(cmd, cmd->cs_inv.acc_addr);
+   cmd->cs_inv.gpu = false;
+   return cmd->cs_inv.acc_addr;
+}
+
+uint64_t
+nvk_cmd_cs_invocations_gpu_acc(struct nvk_cmd_buffer *cmd)
+{
+   assert(!nvk_cmd_buffer_compute_has_mme(cmd));
+
+   /* A secondary counts into its own accumulator, which the primary adds
+    * up when it executes it (nvk_cmd_cs_invocations_execute).
+    */
+   if (cmd->cs_inv.acc_addr == 0 || (!cmd->cs_inv.gpu &&
+       cmd->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY)) {
+      if (nvk_cmd_cs_inv_reset_acc(cmd) == 0)
+         return 0;
+   }
+
+   cmd->cs_inv.gpu = true;
+   return cmd->cs_inv.acc_addr;
+}
+
+void
+nvk_cmd_cs_invocations_zero(struct nvk_cmd_buffer *cmd, uint64_t addr)
+{
+   nvk_cmd_release_word(cmd, addr, 0);
+   nvk_cmd_release_word(cmd, addr + 4, 0);
+}
+
+void
+nvk_cmd_cs_invocations_add(struct nvk_cmd_buffer *cmd, uint64_t count_addr)
+{
+   const uint64_t acc_addr = nvk_cmd_cs_invocations_gpu_acc(cmd);
+   if (acc_addr == 0)
+      return;
+
+   nvk_cmd_cs_inv_dispatch(cmd, acc_addr, count_addr, 0, NVK_CS_INV_OP_ADD);
+}
+
+void
+nvk_cmd_cs_invocations_indirect(struct nvk_cmd_buffer *cmd,
+                                uint64_t indirect_addr, uint32_t local_size)
+{
+   const uint64_t acc_addr = nvk_cmd_cs_invocations_gpu_acc(cmd);
+   if (acc_addr == 0)
+      return;
+
+   nvk_cmd_cs_inv_dispatch(cmd, acc_addr, indirect_addr, local_size,
+                           NVK_CS_INV_OP_INDIRECT);
+}
+
+bool
+nvk_cmd_cs_invocations_execute(struct nvk_cmd_buffer *cmd,
+                               struct nvk_cmd_buffer *secondary)
+{
+   if (nvk_cmd_buffer_compute_has_mme(cmd) ||
+       !cmd->state.cs.active_compute_invocations_query ||
+       !(secondary->state.inherited_pipeline_statistics &
+         VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT))
+      return false;
+
+   cmd->cs_inv.cpu += secondary->cs_inv.cpu;
+   if (secondary->cs_inv.gpu) {
+      /* Right after the secondary: executing it again re-zeroes its
+       * accumulator.
+       */
+      nvk_cmd_cs_inv_dispatch(cmd, cmd->cs_inv.acc_addr,
+                              secondary->cs_inv.acc_addr, 0,
+                              NVK_CS_INV_OP_ADD);
+      cmd->cs_inv.gpu = true;
+      return true;
+   }
+   return false;
+}
