+/* Indirect dispatch on a compute-only queue without MME
+ * (nvk_cmd_buffer_compute_has_mme): the dispatch size reaches the root
+ * descriptor table and the QMD straight from the indirect buffer, fetched by
+ * the host as push-buffer data.  This is how the proprietary driver launches
+ * indirect dispatches on its Turing and Volta compute queues
+ * (libnvidia-eglcore.so 615.71.09 on TU102, 580.178.04 on GV100, push-buffer
+ * capture): an inline-to-memory write of the group count whose three data
+ * words are a GPFIFO segment over the VkDispatchIndirectCommand, then the
+ * QMD loaded inline (SET_INLINE_QMD_ADDRESS + LOAD_INLINE_QMD_DATA), its
+ * CTA_RASTER_WIDTH/HEIGHT/DEPTH words taken from the same segment.
+ */
+static void
+nvk_cmd_dispatch_indirect_inline_qmd(struct nvk_cmd_buffer *cmd,
+                                     uint64_t dispatch_addr)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   const uint32_t qmd_dw = nak_qmd_size_B(&pdev->info) / 4;
+   const uint32_t size_dw = sizeof(VkDispatchIndirectCommand) / 4;
+
+   /* QMD V02_x: CTA_RASTER_WIDTH 415:384, HEIGHT 431:416, DEPTH 463:448,
+    * each in a word of its own (clc3c0qmd.h..clc6c0qmd.h); the indirect
+    * command's 16-bit-bounded y and z leave the reserved upper halves 0.
+    */
+   const struct nak_qmd_dispatch_size_layout qmd_size_layout =
+      nak_get_qmd_dispatch_size_layout(&pdev->info);
+   assert(qmd_size_layout.x_start % 32 == 0 &&
+          qmd_size_layout.y_start == qmd_size_layout.x_start + 32 &&
+          qmd_size_layout.z_start == qmd_size_layout.y_start + 32);
+   const uint32_t size_at_dw = qmd_size_layout.x_start / 32;
+   assert(size_at_dw + size_dw <= qmd_dw);
+
+   uint32_t global_size[3] = { 0, 0, 0 };
+   uint32_t qmd[NAK_MAX_QMD_DWORDS];
+   uint64_t qmd_addr = 0, root_desc_addr = 0;
+   const struct nvk_descriptor_state *desc = &cmd->state.cs.descriptors;
+   VkResult result = nvk_cmd_upload_qmd(cmd, cmd->state.cs.shader, desc,
+                                        desc->root, sizeof(desc->root),
+                                        global_size, false,
+                                        nvk_cmd_qmd_launch(cmd),
+                                        &qmd_addr, &root_desc_addr, qmd);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   const uint64_t group_count_addr = root_desc_addr +
+      offsetof(struct nvk_root_descriptor_table, cs.group_count);
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
+   P_MTHD(p, NVA0C0, LINE_LENGTH_IN);
+   P_NVA0C0_LINE_LENGTH_IN(p, sizeof(VkDispatchIndirectCommand));
+   P_NVA0C0_LINE_COUNT(p, 1);
+   P_NVA0C0_OFFSET_OUT_UPPER(p, group_count_addr >> 32);
+   P_NVA0C0_OFFSET_OUT(p, group_count_addr);
+   P_IMMD(p, NVA0C0, LAUNCH_DMA, {
+      .dst_memory_layout = DST_MEMORY_LAYOUT_PITCH,
+      .sysmembar_disable = SYSMEMBAR_DISABLE_TRUE,
+   });
+   P_0INC(p, NVA0C0, LOAD_INLINE_DATA);
+   nv_push_update_count(p, size_dw);
+   nvk_cmd_buffer_push_indirect(cmd, dispatch_addr,
+                                sizeof(VkDispatchIndirectCommand));
+
+   p = nvk_cmd_buffer_push(cmd, 4 + size_at_dw);
+   P_MTHD(p, NVC3C0, SET_INLINE_QMD_ADDRESS_A);
+   P_NVC3C0_SET_INLINE_QMD_ADDRESS_A(p, qmd_addr >> 40);
+   P_NVC3C0_SET_INLINE_QMD_ADDRESS_B(p, qmd_addr >> 8);
+   P_MTHD(p, NVC3C0, LOAD_INLINE_QMD_DATA(0));
+   P_INLINE_ARRAY(p, qmd, size_at_dw);
+   /* The method's other words: the dispatch size from the indirect buffer,
+    * then the rest of the QMD.
+    */
+   nv_push_update_count(p, qmd_dw - size_at_dw);
+   nvk_cmd_buffer_push_indirect(cmd, dispatch_addr,
+                                sizeof(VkDispatchIndirectCommand));
+
+   const uint32_t tail_dw = qmd_dw - size_at_dw - size_dw;
+   p = nvk_cmd_buffer_push(cmd, tail_dw);
+   memcpy(p->end, &qmd[size_at_dw + size_dw], tail_dw * 4);
+   p->end += tail_dw;
+
+   if (cmd->state.cs.active_compute_invocations_query ||
+       cmd->state.inherited_pipeline_statistics &
+          VK_QUERY_PIPELINE_STATISTIC_COMPUTE_SHADER_INVOCATIONS_BIT) {
+      nvk_cmd_cs_invocations_indirect(cmd, dispatch_addr,
+                                      nvk_compute_local_size(cmd));
+   }
+}
