+static uint64_t
+nvk_dgc_preprocess_size_B(const struct nvk_indirect_commands_layout *layout,
+                          uint32_t max_seq_count)
+{
+   uint64_t size = layout->cmd_seq_stride_B * (uint64_t)max_seq_count;
+   if (layout->qmd_size_per_seq_B > 0) {
+      size = align64(size, NAK_QMD_ALIGN_B);
+      size += QMD_ALLOC_CHUNK_SIZE_B; /* One for the allocator */
+      size += layout->qmd_size_per_seq_B * max_seq_count;
+   }
+   return size;
+}
