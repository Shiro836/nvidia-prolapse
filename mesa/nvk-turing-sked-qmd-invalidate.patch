+/* Volta and Turing compute (no PCAS2 actions; the SKED QMD cache shared by
+ * the channel group's subcontexts): the proprietary driver drops every QMD
+ * a command buffer allocated from the SKED cache at the end of that command
+ * buffer, once its dispatches have completed (libnvidia-eglcore.so.615.78.08
+ * command-buffer end ELF 0xc5c980 -> ELF 0xc5c500 -> ELF 0xc5ba90).  Its
+ * mode word selecting this (ELF 0x568e20) is 1 when the chip-family word
+ * has no bit of 0x6c031e0, i.e. below AMPERE_A, and 2 (no invalidates)
+ * from AMPERE_A on.  QMDs left in the cache would otherwise point at
+ * command-buffer memory that is reused or freed later.
+ */
+bool
+nvk_cmd_sked_qmds_tracked(const struct nvk_physical_device *pdev)
+{
+   return nvk_compute_sked_cache_shared(pdev) &&
+          pdev->info.cls_compute < AMPERE_COMPUTE_A;
+}
+
+/* The command buffer's launch counter, created at the first QMD: the
+ * proprietary driver resets it in the push buffer with a host semaphore
+ * release of 0 followed by an acquire of 0 (ELF 0xc5b300, called when the
+ * command buffer allocates its first QMD, ELF 0xc5cac0 -> ELF 0xc5b500).
+ */
+VkResult
+nvk_cmd_sked_counter(struct nvk_cmd_buffer *cmd, uint64_t *addr_out)
+{
+   if (cmd->sked.counter_addr == 0) {
+      void *map;
+      uint64_t addr;
+      VkResult result = nvk_cmd_buffer_upload_alloc(cmd, 4, 16, &addr, &map);
+      if (unlikely(result != VK_SUCCESS))
+         return result;
+
+      const uint8_t host = nvk_cmd_buffer_host_subc(cmd);
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 12);
+      __push_mthd(p, host, NVC86F_SEM_ADDR_LO);
+      P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
+      P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
+      P_NVC86F_SEM_PAYLOAD_LO(p, 0);
+      P_NVC86F_SEM_PAYLOAD_HI(p, 0);
+      P_NVC86F_SEM_EXECUTE(p, {
+         .operation = OPERATION_RELEASE,
+         .payload_size = PAYLOAD_SIZE_32BIT,
+      });
+      __push_mthd(p, host, NVC86F_SEM_ADDR_LO);
+      P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
+      P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
+      P_NVC86F_SEM_PAYLOAD_LO(p, 0);
+      P_NVC86F_SEM_PAYLOAD_HI(p, 0);
+      P_NVC86F_SEM_EXECUTE(p, {
+         .operation = OPERATION_ACQUIRE,
+         .payload_size = PAYLOAD_SIZE_32BIT,
+      });
+      cmd->sked.counter_addr = addr;
+   }
+   *addr_out = cmd->sked.counter_addr;
+   return VK_SUCCESS;
+}
+
+/* End of a command buffer (ELF 0xc5c500): wait until its dispatches have
+ * completed, then SEND_PCAS_A + SEND_SIGNALING_PCAS_B INVALIDATE (no
+ * SCHEDULE) for each QMD it allocated (ELF 0xc5ba90).  The wait is the
+ * proprietary driver's compute drain (ELF 0xc5a530): a host ACQ_CIRC_GEQ of
+ * the launch counter against the number of dispatches, then a compute
+ * NO_OPERATION.  A command buffer with a dispatch that conditional
+ * rendering may have skipped cannot count on the counter; it idles the
+ * compute engine first, as that driver's QMD ring does before it
+ * invalidates (compute WAIT_FOR_IDLE, ELF 0xabf68a).  Where the inherited
+ * condition may be false the invalidates are made unconditional with
+ * SET_RENDER_ENABLE_OVERRIDE, as the same ring does (ELF 0xabf6c8 /
+ * ELF 0xabf74c).
+ */
+void
+nvk_cmd_sked_end(struct nvk_cmd_buffer *cmd)
+{
+   const struct nvk_physical_device *pdev =
+      nvk_device_physical(nvk_cmd_buffer_device(cmd));
+   const uint32_t count =
+      util_dynarray_num_elements(&cmd->sked.qmds, uint64_t);
+
+   if (!nvk_cmd_sked_qmds_tracked(pdev) || count == 0)
+      return;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 10);
+   if (cmd->sked.wfi_drain) {
+      P_IMMD(p, NVA0C0, WAIT_FOR_IDLE, 0);
+   } else if (cmd->sked.launches > 0) {
+      const uint64_t addr = cmd->sked.counter_addr;
+      __push_mthd(p, nvk_cmd_buffer_host_subc(cmd), NVC86F_SEM_ADDR_LO);
+      P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
+      P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
+      P_NVC86F_SEM_PAYLOAD_LO(p, cmd->sked.launches);
+      P_NVC86F_SEM_PAYLOAD_HI(p, 0);
+      P_NVC86F_SEM_EXECUTE(p, {
+         .operation = OPERATION_ACQ_CIRC_GEQ,
+         .payload_size = PAYLOAD_SIZE_32BIT,
+      });
+      P_IMMD(p, NVA0C0, NO_OPERATION, 0);
+   }
+
+   if (cmd->sked.render_override) {
+      p = nvk_cmd_buffer_push(cmd, 2);
+      P_IMMD(p, NVA0C0, SET_RENDER_ENABLE_OVERRIDE, MODE_ALWAYS_RENDER);
+   }
+
+   util_dynarray_foreach(&cmd->sked.qmds, uint64_t, qmd_addr) {
+      p = nvk_cmd_buffer_push(cmd, 4);
+      P_MTHD(p, NVA0C0, SEND_PCAS_A);
+      P_NVA0C0_SEND_PCAS_A(p, *qmd_addr >> 8);
+      P_IMMD(p, NVA0C0, SEND_SIGNALING_PCAS_B, {
+         .invalidate = INVALIDATE_TRUE,
+         .schedule = SCHEDULE_FALSE,
+      });
+   }
+
+   if (cmd->sked.render_override) {
+      p = nvk_cmd_buffer_push(cmd, 2);
+      P_IMMD(p, NVA0C0, SET_RENDER_ENABLE_OVERRIDE, MODE_USE_RENDER_ENABLE);
+   }
+}
