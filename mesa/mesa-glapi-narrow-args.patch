From ac250dd8497d35cc4bb2fedc94303dcdc8c93c6f Mon Sep 17 00:00:00 2001
From: Shiro836 <noreply>
Date: Sat, 17 Oct 2026 23:20:28 +0300
Subject: [PATCH] glapi: extend narrow integer arguments in x86 entry points

The x86-64 SysV psABI leaves the bits above an 8- or 16-bit argument
unspecified, and its maintainers intend callees to cope with that [1].
Clang-built callees instead assume the caller sign/zero-extended such
arguments to 32 bits [2]; GCC-built callees do not. Callers that do not
extend (binary translators bridging another ABI, hand-written assembly)
therefore hand Mesa GLboolean/GLubyte/GLshort arguments with garbage in the
upper bits whenever Mesa is built with clang.

Seen on Android x86_64 (NDK clang) with an arm64 Unity game run through
the ARM translation layer: it calls glColorMask(GL_FALSE, GL_FALSE,
GL_FALSE, GL_TRUE) and the x86-64 entry receives red=0x0 green=0x10000
blue=0x100 alpha=0x1. _mesa_ColorMask tests the whole registers
(testl %esi,%esi), builds the mask G|B|A instead of A, and a pass meant to
write only alpha zeroes green and blue: white surfaces turn red.

Make the dispatch entry points do the extension themselves for the
functions that take integer parameters narrower than 32 bits (GLboolean,
GLubyte, GLushort, GLhalf*, GLbyte, GLshort, GLchar*), on x86 and x86-64
ELF:

- C entries (exported ES1/ES2 entries and the shared-glapi table used by
  GetProcAddress when the TLS asm stubs are not used, e.g. on bionic):
  the generators emit a definition taking those parameters as GLuint/GLint
  that casts them back to the narrow type before the dispatch call, bound
  to the GL symbol with an asm label (the GL headers already declare that
  name with the narrow types). Other functions are unchanged.
- TLS asm stubs (entry_x86-64_tls.h, entry_x86_tls.h): the stub of such a
  function jumps to a generated hidden C entry of the same shape; it stays
  within the 32-byte stub slot, and x86's entry_patch_public leaves these
  stubs alone.

The exported symbol set is unchanged. On x86-64 the cost is one movzbl or
movsbl per narrow argument (plus one jmp for the asm stubs); on i386 clang
already loads such stack arguments with byte loads, so the generated code
there is equivalent.

[1] https://groups.google.com/g/x86-64-abi/c/h7FFh30oS3s/m/NDV4lCRQAQAJ
[2] https://discourse.llvm.org/t/always-extend-the-integer-parameters-of-callee/61319
---
 src/mesa/glapi/entry_x86-64_tls.h         |   8 ++
 src/mesa/glapi/entry_x86_tls.h            |  11 +++
 src/mesa/glapi/mapi_abi.py                | 113 +++++++++++++++++++++-
 src/mesa/glapi/new/gen_gldispatch_mapi.py |  77 ++++++++++++++-
 src/mesa/glapi/shared-glapi/core.c        |  11 ++-
 5 files changed, 215 insertions(+), 5 deletions(-)

diff --git a/src/mesa/glapi/entry_x86-64_tls.h b/src/mesa/glapi/entry_x86-64_tls.h
index 83542035f0fe..98424e54ec68 100644
--- a/src/mesa/glapi/entry_x86-64_tls.h
+++ b/src/mesa/glapi/entry_x86-64_tls.h
@@ -47,6 +47,14 @@ __asm__(".text\n"
    ".balign 32\n"                                        \
    func ":"
 
+/* Stub of a function with integer parameters narrower than 32 bits: jumps
+ * to a C entry (generated next to the stubs) that sign/zero-extends them
+ * before the dispatch call.  Fits the 32-byte stub slot.
+ */
+#define STUB_ASM_NARROW_CODE(target)                     \
+   ENDBR                                                 \
+   "jmp " target
+
 #ifndef __ILP32__
 
 #define STUB_ASM_CODE(slot)                              \
diff --git a/src/mesa/glapi/entry_x86_tls.h b/src/mesa/glapi/entry_x86_tls.h
index 18d00b2b7540..3125a07c9371 100644
--- a/src/mesa/glapi/entry_x86_tls.h
+++ b/src/mesa/glapi/entry_x86_tls.h
@@ -64,6 +64,17 @@ __asm__(".balign 16\n"
    ".balign 16\n"                \
    func ":"
 
+/* Stub of a function with integer parameters narrower than 32 bits: jumps
+ * to a C entry (generated next to the stubs) that sign/zero-extends them
+ * before the dispatch call, padded to the 32-byte slot (X86_ENTRY_SIZE) of
+ * the 16-byte aligned stubs.  entry_patch_public leaves these stubs alone.
+ */
+#define STUB_ASM_NARROW_CODE(target)                        \
+   ENDBR                                                    \
+   "jmp " target "\n\t"                                     \
+   ".balign 16\n\t"                                         \
+   ".skip 16"
+
 #define STUB_ASM_CODE(slot)                                 \
    ENDBR                                                    \
    "call 1f\n"                                              \
diff --git a/src/mesa/glapi/mapi_abi.py b/src/mesa/glapi/mapi_abi.py
index aa03ed408ad8..b36d8bd57a24 100644
--- a/src/mesa/glapi/mapi_abi.py
+++ b/src/mesa/glapi/mapi_abi.py
@@ -38,6 +38,18 @@ import glX_XML
 import static_data
 
 
+# Integer parameter types narrower than 32 bits, and the 32-bit type their
+# entry points receive them as (see ABIPrinter._c_wide_entry).  Same table
+# as new/gen_gldispatch_mapi.py.
+NARROW_TYPES = {
+    "GLboolean": "GLuint", "GLubyte": "GLuint", "GLushort": "GLuint",
+    "GLhalf": "GLuint", "GLhalfNV": "GLuint", "GLhalfARB": "GLuint",
+    "GLbyte": "GLint", "GLshort": "GLint", "GLchar": "GLint", "GLcharARB": "GLint",
+}
+
+NARROW_GUARD = ("defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__)) && "
+                "defined(__ELF__)")
+
 class ABIEntry(object):
     """Represent an ABI entry."""
 
@@ -75,6 +87,31 @@ class ABIEntry(object):
 
         return ", ".join(c_params)
 
+    def has_narrow_params(self):
+        return any(not a and t in NARROW_TYPES for t, n, a in self.params)
+
+    def c_wide_params(self):
+        """Return the parameter list with narrow integers widened to 32 bits."""
+        c_params = []
+        for t, n, a in self.params:
+            if not a and t in NARROW_TYPES:
+                t = NARROW_TYPES[t]
+            sep = '' if t.endswith('*') else ' '
+            arr = '[%d]' % a if a else ''
+            c_params.append(t + sep + n + arr)
+        if not c_params:
+            c_params.append('void')
+
+        return ", ".join(c_params)
+
+    def c_narrow_args(self):
+        """Return the argument list converting widened integers back."""
+        c_args = []
+        for t, n, a in self.params:
+            c_args.append('(%s) %s' % (t, n) if not a and t in NARROW_TYPES else n)
+
+        return ", ".join(c_args)
+
     def c_args(self):
         """Return the argument list used in the entry invocation."""
         c_args = []
@@ -274,6 +311,31 @@ class ABIPrinter(object):
 
         return cast
 
+    def _c_wide_entry(self, ent, cname, asmname, export):
+        """Return an entry point for an entry with integer parameters
+        narrower than 32 bits that takes them as 32-bit integers and converts
+        them back before the dispatch call.
+
+        The x86-64 SysV and i386 ABIs leave the bits above a char/short
+        argument unspecified, but clang-built callees assume the caller
+        sign/zero-extended it to 32 bits, so callers that do not (binary
+        translators bridging other ABIs, hand-written assembly) feed garbage
+        into GLboolean/GLubyte tests.  asmname gives the definition the
+        entry's symbol name, which the GL headers declare with the narrow
+        types."""
+        ret = 'return ' if ent.ret else ''
+        label = ' __asm__("%s")' % asmname if asmname else ''
+        decl = '%s%s %s %s(%s)' % (export, ent.c_return(), 'GLAPIENTRY', cname,
+                                   ent.c_wide_params())
+        return r"""%s%s;
+%s
+{
+   const struct _glapi_table *_tbl = GET_DISPATCH();
+   _glapi_proc _func = ((const _glapi_proc *) _tbl)[%d];
+   %s((%s) _func)(%s);
+}
+""" % (decl, label, decl, ent.slot, ret, self._c_cast(ent), ent.c_narrow_args())
+
     def c_public_dispatches(self, no_hidden):
         """Return the public dispatch functions."""
         dispatches = []
@@ -290,13 +352,20 @@ class ABIPrinter(object):
             ret = 'return ' if ent.ret else ''
             cast = self._c_cast(ent)
 
-            dispatches.append(r"""%s%s
+            plain = r"""%s
 {
    const struct _glapi_table *_tbl = GET_DISPATCH();
    _glapi_proc _func = ((const _glapi_proc *) _tbl)[%d];
    %s((%s) _func)(%s);
-}%s
-""" % (if0, decl, ent.slot, ret, cast, ent.c_args(), endif))
+}
+""" % (decl, ent.slot, ret, cast, ent.c_args())
+            if ent.has_narrow_params():
+                name = self._c_function(ent, self.prefix, True)
+                export = 'GLAPI ' if not ent.hidden else ''
+                plain = '#if %s\n%s#else\n%s#endif\n' % (
+                    NARROW_GUARD, self._c_wide_entry(ent, '_mesa_wide_' + name, name, export),
+                    plain)
+            dispatches.append('%s%s%s' % (if0, plain, endif))
 
         return '\n'.join(dispatches)
 
@@ -375,6 +444,27 @@ class ABIPrinter(object):
         pre = self.indent + '(_glapi_proc) '
         return pre + (',\n' + pre).join(entries)
 
+    def c_narrow_entries(self, no_hidden):
+        """Return the C entries the narrow stubs of c_asm_gcc jump to."""
+        entries = []
+        for ent in self.entries:
+            if ent.hidden and no_hidden:
+                continue
+            if not self.need_entry_point(ent) or ent.handcode or ent.alias:
+                continue
+            if ent.has_narrow_params():
+                entries.append(self._c_wide_entry(
+                    ent, '_mesa_narrow_' + self._c_function(ent, self.prefix, True), None,
+                    '__attribute__((visibility("hidden"), used)) '))
+        return "\n".join(entries)
+
+    def c_narrow_slots(self):
+        """Return the slots whose stubs are narrow (not runtime-patched)."""
+        slots = sorted(set(ent.slot for ent in self.entries
+                           if self.need_entry_point(ent) and not ent.handcode and
+                           not ent.alias and ent.has_narrow_params()))
+        return ", ".join("%d" % slot for slot in slots)
+
     def c_asm_gcc(self, no_hidden):
         asm = []
 
@@ -397,6 +487,14 @@ class ABIPrinter(object):
                 asm.append('".globl "%s"\\n"' % (name))
                 asm.append('".set "%s", "%s"\\n"' % (name,
                     self._c_function(ent.alias, self.prefix, True, True)))
+            elif ent.has_narrow_params():
+                asm.append('STUB_ASM_ENTRY(%s)"\\n"' % (name))
+                asm.append('#ifdef STUB_ASM_NARROW_CODE')
+                asm.append('"\\t"STUB_ASM_NARROW_CODE("_mesa_narrow_%s")"\\n"' %
+                           self._c_function(ent, self.prefix, True))
+                asm.append('#else')
+                asm.append('"\\t"STUB_ASM_CODE("%d")"\\n"' % (ent.slot))
+                asm.append('#endif')
             else:
                 asm.append('STUB_ASM_ENTRY(%s)"\\n"' % (name))
                 asm.append('"\\t"STUB_ASM_CODE("%d")"\\n"' % (ent.slot))
@@ -461,6 +559,12 @@ class ABIPrinter(object):
 
             print()
             print('#ifdef MAPI_TMP_STUB_ASM_GCC')
+            print('#ifdef STUB_ASM_NARROW_CODE')
+            print(self.c_narrow_entries(False))
+            print('static const unsigned short mapi_narrow_slots[] = {')
+            print(self.indent + self.c_narrow_slots())
+            print('};')
+            print('#endif /* STUB_ASM_NARROW_CODE */')
             print('__asm__(')
             print(self.c_asm_gcc(False))
             print(');')
@@ -483,6 +587,9 @@ class ABIPrinter(object):
 
                 print()
                 print('#ifdef MAPI_TMP_STUB_ASM_GCC_NO_HIDDEN')
+                print('#ifdef STUB_ASM_NARROW_CODE')
+                print(self.c_narrow_entries(True))
+                print('#endif /* STUB_ASM_NARROW_CODE */')
                 print('__asm__(')
                 print(self.c_asm_gcc(True))
                 print(');')
diff --git a/src/mesa/glapi/new/gen_gldispatch_mapi.py b/src/mesa/glapi/new/gen_gldispatch_mapi.py
index d3269ac5fc68..e13de92264c9 100755
--- a/src/mesa/glapi/new/gen_gldispatch_mapi.py
+++ b/src/mesa/glapi/new/gen_gldispatch_mapi.py
@@ -111,11 +111,67 @@ def generate_public_stubs(functions):
     text += "#endif /* MAPI_TMP_PUBLIC_STUBS */\n"
     return text
 
+# Integer parameter types narrower than 32 bits, and the 32-bit type their
+# entry points receive them as (see generate_public_entries).
+NARROW_TYPES = {
+    "GLboolean": "GLuint", "GLubyte": "GLuint", "GLushort": "GLuint",
+    "GLhalf": "GLuint", "GLhalfNV": "GLuint", "GLhalfARB": "GLuint",
+    "GLbyte": "GLint", "GLshort": "GLint", "GLchar": "GLint", "GLcharARB": "GLint",
+}
+
+# Guard for the widened entry points: x86 and x86-64 ELF, where GCC-style
+# asm labels name the symbol directly.
+NARROW_GUARD = ("defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__)) && "
+                "defined(__ELF__)")
+
+def has_narrow_args(func):
+    return any(arg.type in NARROW_TYPES for arg in func.args)
+
+def wide_dec_args(func):
+    return ", ".join("{t} {n}".format(t=NARROW_TYPES[arg.type], n=arg.name)
+                     if arg.type in NARROW_TYPES else arg.dec for arg in func.args)
+
+def narrow_call_args(func):
+    return ", ".join("({t}) {n}".format(t=arg.type, n=arg.name)
+                     if arg.type in NARROW_TYPES else arg.name for arg in func.args)
+
+def generate_wide_entry(func, cname, asmname, export):
+    """
+    An entry point for a function with integer parameters narrower than 32
+    bits, taking them as 32-bit integers and converting them back before the
+    dispatch call.
+
+    The x86-64 SysV and i386 ABIs leave the bits above a char/short argument
+    unspecified, but clang-built callees assume the caller sign/zero-extended
+    it to 32 bits, so callers that do not (binary translators bridging other
+    ABIs, hand-written assembly) feed garbage into GLboolean/GLubyte tests.
+    Declaring the parameter as 32 bits and casting makes this entry do the
+    extension itself. asmname gives the definition the GL symbol name, since
+    the GL headers already declare that name with the narrow types.
+    """
+    retStr = ("return " if func.hasReturn() else "")
+    labelStr = ' __asm__("{0}")'.format(asmname) if asmname else ""
+    return r"""
+{export}{f.rt} GLAPIENTRY {cname}({wideArgs}){labelStr};
+{export}{f.rt} GLAPIENTRY {cname}({wideArgs})
+{{
+   const struct _glapi_table *_tbl = GET_DISPATCH();
+   _glapi_proc _func = ((const _glapi_proc *) _tbl)[{f.slot}];
+   {retStr}(({f.rt} (GLAPIENTRY *)({f.decArgs})) _func)({narrowArgs});
+}}
+""".lstrip("\n").format(f=func, cname=cname, export=export, labelStr=labelStr,
+                       wideArgs=wide_dec_args(func), narrowArgs=narrow_call_args(func),
+                       retStr=retStr)
+
 def generate_public_entries(functions):
     text = "#ifdef MAPI_TMP_PUBLIC_ENTRIES_NO_HIDDEN\n"
 
     for func in functions:
         retStr = ("return " if func.hasReturn() else "")
+        if has_narrow_args(func):
+            text += "#if " + NARROW_GUARD + "\n"
+            text += generate_wide_entry(func, "_mesa_wide_" + func.name, func.name, "GLAPI ")
+            text += "#else\n"
         text += r"""
 GLAPI {f.rt} GLAPIENTRY {f.name}({f.decArgs})
 {{
@@ -125,6 +181,8 @@ GLAPI {f.rt} GLAPIENTRY {f.name}({f.decArgs})
 }}
 
 """.lstrip("\n").format(f=func, retStr=retStr)
+        if has_narrow_args(func):
+            text += "#endif\n"
 
     text += "\n"
     text += "#endif /* MAPI_TMP_PUBLIC_ENTRIES_NO_HIDDEN */\n"
@@ -147,11 +205,28 @@ def generate_undef_public_entries():
 
 def generate_stub_asm_gcc(functions):
     text = "#ifdef MAPI_TMP_STUB_ASM_GCC_NO_HIDDEN\n"
+    # Stubs of functions with narrow integer parameters jump to a C entry
+    # that extends them (generate_wide_entry); the narrow-stub macro of
+    # entry_*_tls.h names it.
+    text += "#ifdef STUB_ASM_NARROW_CODE\n"
+    text += "#include \"util/glheader.h\"\n"
+    for func in functions:
+        if has_narrow_args(func):
+            text += generate_wide_entry(func, "_mesa_narrow_" + func.name, None,
+                                        "__attribute__((visibility(\"hidden\"), used)) ")
+    text += "#endif /* STUB_ASM_NARROW_CODE */\n"
     text += "__asm__(\n"
 
     for func in functions:
         text += 'STUB_ASM_ENTRY("%s")"\\n"\n' % (func.name,)
-        text += '"\\t"STUB_ASM_CODE("%d")"\\n"\n\n' % (func.slot,)
+        if has_narrow_args(func):
+            text += '#ifdef STUB_ASM_NARROW_CODE\n'
+            text += '"\\t"STUB_ASM_NARROW_CODE("_mesa_narrow_%s")"\\n"\n' % (func.name,)
+            text += '#else\n'
+        text += '"\\t"STUB_ASM_CODE("%d")"\\n"\n' % (func.slot,)
+        if has_narrow_args(func):
+            text += '#endif\n'
+        text += '\n'
 
     text += ");\n"
     text += "#undef MAPI_TMP_STUB_ASM_GCC_NO_HIDDEN\n"
diff --git a/src/mesa/glapi/shared-glapi/core.c b/src/mesa/glapi/shared-glapi/core.c
index 04a0caaef933..5f3224ae1704 100644
--- a/src/mesa/glapi/shared-glapi/core.c
+++ b/src/mesa/glapi/shared-glapi/core.c
@@ -48,9 +48,18 @@ entry_patch_public(void)
 #ifndef GLX_X86_READONLY_TEXT
    char *entry;
    int slot = 0;
+   unsigned narrow = 0;
    for (entry = x86_entry_start; entry < x86_entry_end;
-        entry += X86_ENTRY_SIZE, ++slot)
+        entry += X86_ENTRY_SIZE, ++slot) {
+      /* Stubs with narrow integer parameters jump to their extending C
+       * entry (STUB_ASM_NARROW_CODE); the patched code would skip it. */
+      if (narrow < ARRAY_SIZE(mapi_narrow_slots) &&
+          mapi_narrow_slots[narrow] == slot) {
+         narrow++;
+         continue;
+      }
       entry_generate_or_patch(slot, entry, X86_ENTRY_SIZE);
+   }
 #endif
 }
 
