+/// CTA_LAUNCH_QUEUE and QMD_GROUP_ID of a dispatch QMD by the queue family
+/// that records it, as NVIDIA's driver sets them (libnvidia-eglcore.so
+/// 615.78.08, dispatch launch fields at ELF 0xc5aed0: launch set by family at
+/// ELF 0xc5a4c0, CTA_LAUNCH_QUEUE = its bit 0, defaults 0 for the graphics
+/// family and 1 for the compute family (settings read at ELF 0xa39385);
+/// QMD group by family at ELF 0xc98910, defaults 0x1f and 0x20 (ELF
+/// 0x56bd1c / 0x56bc06)).  The driver writes the group in every QMD layout
+/// from Turing on and CTA_LAUNCH_QUEUE from the AMPERE_COMPUTE_B layout on
+/// (its layouts for TURING_COMPUTE_A and AMPERE_COMPUTE_A have none).
+/// Volta and older are not handled by that driver: their QMDs keep NAK's
+/// defaults.
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_launch_queue(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    compute_family: bool,
+) {
+    assert!(!qmd.is_null());
+    assert!(qmd_size == nak_qmd_size_B(dev) as usize);
+    let words =
+        unsafe { std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4) };
+    use nvidia_headers::classes::clc3c0::qmd as q_c3c0;
+    use nvidia_headers::classes::clc6c0::qmd as q_c6c0;
+    use nvidia_headers::classes::clc7c0::qmd as q_c7c0;
+    use nvidia_headers::classes::clcbc0::qmd as q_cbc0;
+    use nvidia_headers::classes::clcdc0::qmd as q_cdc0;
+    let mut bv = QMDBitView::new(words);
+    let group: u32 = if compute_family { 0x20 } else { 0x1f };
+    let queue: u32 = if compute_family { 1 } else { 0 };
+    if dev.cls_compute >= clcdc0::BLACKWELL_COMPUTE_A {
+        set_field!(bv, q_cdc0, QMDV05_00, CTA_LAUNCH_QUEUE, queue);
+        set_field!(bv, q_cdc0, QMDV05_00, QMD_GROUP_ID, group);
+    } else if dev.cls_compute >= clcbc0::HOPPER_COMPUTE_A {
+        set_field!(bv, q_cbc0, QMDV04_00, CTA_LAUNCH_QUEUE, queue);
+        set_field!(bv, q_cbc0, QMDV04_00, QMD_GROUP_ID, group);
+    } else if dev.cls_compute >= clc7c0::AMPERE_COMPUTE_B {
+        set_field!(bv, q_c7c0, QMDV03_00, CTA_LAUNCH_QUEUE, queue);
+        set_field!(bv, q_c7c0, QMDV03_00, QMD_GROUP_ID, group);
+    } else if dev.cls_compute >= clc6c0::AMPERE_COMPUTE_A {
+        set_field!(bv, q_c6c0, QMDV03_00, QMD_GROUP_ID, group);
+    } else if dev.cls_compute >= clc5c0::TURING_COMPUTE_A {
+        set_field!(bv, q_c3c0, QMDV02_02, QMD_GROUP_ID, group);
+    }
+}
