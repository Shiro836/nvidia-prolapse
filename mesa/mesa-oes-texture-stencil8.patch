# OES_texture_stencil8 (https://registry.khronos.org/OpenGL/extensions/OES/OES_texture_stencil8.txt):
# "Accepted by the <format> parameter of TexImage3D, TexImage2D, TexSubImage3D
# and TexSubImage2D: STENCIL_INDEX". Mesa exposes the extension from ES 3.0
# (main/extensions_table.h:507) but valid_texture_format_enum accepted
# STENCIL_INDEX only for desktop GL / ES 3.1, so ES 3.0 contexts reported
# GL_INVALID_ENUM (dEQP-GLES2/3 fbo.completeness.*.stencil_index8).
diff --git a/src/mesa/main/glformats.c b/src/mesa/main/glformats.c
index 022d47aa76376847c99b97d0342520334ad32832..71df87c4a5edde010e7318ebbc7dc9b2f6af3e7a 100644
--- a/src/mesa/main/glformats.c
+++ b/src/mesa/main/glformats.c
@@ -1769,7 +1769,10 @@ valid_texture_format_enum(const struct gl_context *ctx, GLenum format)
       return true;
 
    case GL_STENCIL_INDEX:
-      return _mesa_is_desktop_gl(ctx) || _mesa_is_gles31(ctx);
+      /* OES_texture_stencil8 (written against ES 3.1, exposed by Mesa from
+       * ES 3.0) adds STENCIL_INDEX as a TexImage format. */
+      return _mesa_is_desktop_gl(ctx) || _mesa_is_gles31(ctx) ||
+             _mesa_has_OES_texture_stencil8(ctx);
 
    case GL_COLOR_INDEX:
       return _mesa_is_desktop_gl_compat(ctx);
