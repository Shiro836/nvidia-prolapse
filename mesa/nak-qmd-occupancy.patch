+            set_field!(bv, clcdc0, QMDV05_00, OCCUPANCY_THRESHOLD_WARP, 0x10_u32);
+            set_field!(bv, clcdc0, QMDV05_00, OCCUPANCY_MAX_WARP, 0xff_u32);
+            set_field!(bv, clcdc0, QMDV05_00, OCCUPANCY_THRESHOLD_REGISTER, 0x40_u32);
+            set_field!(bv, clcdc0, QMDV05_00, OCCUPANCY_MAX_REGISTER, 0xff_u32);
             Self { qmd }
