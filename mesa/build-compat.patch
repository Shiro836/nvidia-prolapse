diff --git a/meson.build b/meson.build
index 5f19ef921a6c762d25fda834ff02c95715ad62b2..d7caa252428bd0bfe6a5b37e2e09f36b9fd4fa6f 100644
--- a/meson.build
+++ b/meson.build
@@ -1676,8 +1676,8 @@ endif
 
 with_c11_threads = false
 if cc.has_function('thrd_create', prefix: '#include <threads.h>')
-  if with_platform_android
-    # Current only Android's c11 <threads.h> are verified
+  if host_machine.system() in ['android', 'linux']
+    # Native build: match glibc and bionic C11 thread definitions
     pre_args += '-DHAVE_THRD_CREATE'
     with_c11_threads = true
   endif
diff --git a/src/util/cnd_monotonic.c b/src/util/cnd_monotonic.c
index 71d9ac0d247735064765d3b5b1928a85aa7d3bdb..a99ad3a723e5b5022dbcdf0153f8bb6de92f4f6f 100644
--- a/src/util/cnd_monotonic.c
+++ b/src/util/cnd_monotonic.c
@@ -40,6 +40,11 @@ static_assert(sizeof(mtx_t) == sizeof(CRITICAL_SECTION),
               "The size of mtx_t must equal to CRITICAL_SECTION");
 #endif
 
+#if defined(__GLIBC__) && defined(HAVE_THRD_CREATE)
+_Static_assert(sizeof(mtx_t) == sizeof(pthread_mutex_t), "glibc mutex size");
+_Static_assert(_Alignof(mtx_t) == _Alignof(pthread_mutex_t), "glibc mutex alignment");
+#endif
+
 int
 u_cnd_monotonic_init(struct u_cnd_monotonic *cond)
 {
@@ -132,7 +137,7 @@ u_cnd_monotonic_timedwait(struct u_cnd_monotonic *cond, mtx_t *mtx,
    timespec_sub_saturate(&rel_time, abs_time, &now_time);
    int rt = pthread_cond_timedwait_relative_np(&cond->cond, mtx, &rel_time);
 #else
-   int rt = pthread_cond_timedwait(&cond->cond, mtx, abs_time);
+   int rt = pthread_cond_timedwait(&cond->cond, (pthread_mutex_t *)mtx, abs_time);
 #endif
    if (rt == ETIMEDOUT)
       return thrd_timedout;
@@ -151,6 +156,6 @@ u_cnd_monotonic_wait(struct u_cnd_monotonic *cond, mtx_t *mtx)
                             (PCRITICAL_SECTION)mtx, INFINITE);
    return thrd_success;
 #else
-   return (pthread_cond_wait(&cond->cond, mtx) == 0) ? thrd_success : thrd_error;
+   return (pthread_cond_wait(&cond->cond, (pthread_mutex_t *)mtx) == 0) ? thrd_success : thrd_error;
 #endif
 }
