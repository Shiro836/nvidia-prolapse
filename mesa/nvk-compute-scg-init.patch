+/* SCG (compute-in-graphics) setup of the proprietary driver's compute-context
+ * initialiser (libnvidia-eglcore.so.615.78.08 E 0x56f1c0), selected by the
+ * per-3D-class flag word its device setup stores (table E 0xfaf160, lookup
+ * E 0x4e3cf0; tests E 0x56f6e9 & 0x8011e0, E 0x56f731 & 0x1200000, and the
+ * defaults of E 0x569190: & 0x68031e0, & 0x1040).
+ *
+ *   scg_control   SET_SCG_CONTROL and the SM SCG control sequence are sent
+ *                 (Turing..Ada; Hopper and Blackwell set a bit of 0x8011e0)
+ *   falcon10      Turing carries the SM SCG control value in SET_FALCON10
+ *                 (method 0x0528) instead of SET_SM_SCG_CONTROL (0x01e8)
+ *   compute_in_graphics  the SM SCG control value (E 0x569190: flag word &
+ *                 0x68031e0 != 0, i.e. GA10x and AD10x)
+ *   sched0        byte 0 of SET_SCG_COMPUTE_SCHEDULING_PARAMETERS: 6, or 0
+ *                 on Blackwell B (E 0x569190 stores 0x0080801f there for
+ *                 flag word & 0x1040)
+ *
+ * Classes without a row (Volta and older, and any class newer than the
+ * table) are not described here and get none of these methods.
+ */
+struct nvk_stock_scg {
+   bool known, scg_control, falcon10, compute_in_graphics;
+   uint8_t sched0;
+};
+
+static struct nvk_stock_scg
+nvk_stock_scg(uint16_t cls_eng3d)
+{
+   switch (cls_eng3d) {
+   case TURING_A:    return (struct nvk_stock_scg) { true, true, true, false, 6 };
+   case AMPERE_A:    return (struct nvk_stock_scg) { true, true, false, false, 6 };
+   case AMPERE_B:    return (struct nvk_stock_scg) { true, true, false, true, 6 };
+   case ADA_A:       return (struct nvk_stock_scg) { true, true, false, true, 6 };
+   case HOPPER_A:    return (struct nvk_stock_scg) { true, false, false, false, 6 };
+   case BLACKWELL_A: return (struct nvk_stock_scg) { true, false, false, false, 6 };
+   case BLACKWELL_B: return (struct nvk_stock_scg) { true, false, false, false, 0 };
+   default:          return (struct nvk_stock_scg) { false };
+   }
+}
+
+/* SET_SCG_CONTROL of the proprietary driver's compute-context initialiser
+ * (615.78.08 E 0x56f326..E 0x56f4b6, one word per subdevice): with
+ * tpcs = SHADER_PIPE_SUB_COUNT and pipes = SHADER_PIPE_COUNT, and its default
+ * weights 0x67/256 (maximum) and 0/256 (minimum) of the TPCs per pipe
+ * (E 0x56bbc2, E 0x56bd15):
+ *   COMPUTE1_MAX_SM_COUNT = max(1, min(tpcs - pipes,
+ *                                      round(tpcs / pipes * 0x67 / 256) * pipes))
+ *   COMPUTE1_MIN_SM_COUNT = min(max, round(tpcs / pipes * 0 / 256) * pipes)
+ *   DISABLE_COMPUTE1_LIMIT_IN_ALL_COMPUTE = 1
+ * (tpcs < pipes takes 1 for both when the rounded maximum is non-zero.)
+ * Each product saturates at 0xffffffff as in stock.
+ */
+static uint32_t
+nvk_stock_scg_control(uint32_t tpcs, uint32_t pipes)
+{
+   const uint64_t w_max = 0x67, w_min = 0;
+   const uint32_t q = tpcs / pipes;
+   uint64_t t = MIN2((uint64_t)q * w_max + 0x80, 0xffffffffull);
+   const uint64_t prod = (uint64_t)((uint32_t)t >> 8) * pipes;
+   const uint32_t r11 = MIN2(prod, 0xffffffffull);
+   uint32_t max, sel;
+   if (tpcs < pipes) {
+      if (prod != 0) {
+         max = 1;
+         sel = 1;
+      } else {
+         sel = r11 == 0 ? 1 : r11;
+         max = sel & 0x1ff;
+      }
+   } else {
+      sel = MIN2(tpcs - pipes, r11);
+      if (sel == 0)
+         sel = 1;
+      max = sel & 0x1ff;
+   }
+   t = MIN2((uint64_t)q * w_min + 0x80, 0xffffffffull);
+   const uint64_t lim = MIN2((uint64_t)((uint32_t)t >> 8) * pipes,
+                             0xffffffffull);
+   if (sel >= lim)
+      sel = lim;
+   return max | ((sel << 12) & 0x1ff000) | (1u << 24);
+}
