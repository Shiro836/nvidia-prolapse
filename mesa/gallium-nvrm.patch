diff --git a/src/loader/loader.c b/src/loader/loader.c
index 0bbccbf5b239c8864eca5bd07594981e620a1eb7..8575e69ff561b0c43dd0d79e35668569f8a1b11c 100644
--- a/src/loader/loader.c
+++ b/src/loader/loader.c
@@ -801,6 +801,15 @@ loader_get_driver_for_fd(int fd)
    driver = loader_get_pci_driver(fd);
    if (!driver)
       driver = loader_get_kernel_driver_name(fd);
+#ifdef HAVE_NVRM
+   /* NVIDIA's own kernel driver ("nvidia-drm") is served by the nvrm gallium
+    * driver over the RM backend. The kernel name is not a valid Mesa driver
+    * identifier, so it is mapped explicitly. */
+   if (driver && strcmp(driver, "nvidia-drm") == 0) {
+      free(driver);
+      driver = strdup("nvrm");
+   }
+#endif
 
    return driver;
 }
