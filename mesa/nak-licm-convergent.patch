+/* nir_opt_licm filter: a convergent ALU result, constant or constant-buffer
+ * load whose loop is entered in uniform control flow.  Such a value is held
+ * in a uniform register (from_nir places convergent values of uniform blocks
+ * there), which does not count against the GPR budget.
+ *
+ * ALU ops never trap and a bound constant buffer (ldc_nv) is always valid, so
+ * those may be hoisted from any block of the loop.  A bindless load (ldcx_nv)
+ * goes through a handle the shader may only use under a condition, so it is
+ * only hoisted from blocks every iteration that leaves the loop executes.
+ */
+static bool
+nak_licm_filter(nir_instr *instr, nir_loop *loop, bool dominates_exit)
+{
+   if (nir_loop_predecessor_block(loop)->divergent)
+      return false;
+
+   switch (instr->type) {
+   case nir_instr_type_load_const:
+      return true;
+
+   case nir_instr_type_alu:
+      return !nir_instr_as_alu(instr)->def.divergent;
+
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+      if (intrin->intrinsic != nir_intrinsic_ldc_nv &&
+          intrin->intrinsic != nir_intrinsic_ldcx_nv)
+         return false;
+      if (intrin->intrinsic == nir_intrinsic_ldcx_nv && !dominates_exit)
+         return false;
+      if (nir_intrinsic_access(intrin) & ACCESS_NON_UNIFORM)
+         return false;
+      return !intrin->def.divergent;
+   }
+
+   default:
+      return false;
+   }
+}
+
 void
 nak_postprocess_nir(nir_shader *nir,
