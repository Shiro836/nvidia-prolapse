+/* SET_SPA_VERSION and SET_QMD_VERSION words of the proprietary driver's
+ * compute-context initialiser (libnvidia-eglcore.so.615.78.08 E 0x56f1c0),
+ * selected by the SM ISA code: one SET_SPA_VERSION per code, plus
+ * SET_QMD_VERSION from 0x900 on.  Its selector equals RM's SM version
+ * code on the chips captured (SPA 0x705 on TU106, 0xa04 on GB202), and
+ * every code it does not list takes the default arm (E 0x56fa60):
+ * SET_SPA_VERSION 0x500 and no SET_QMD_VERSION.
+ */
+static bool
+nvk_stock_spa_qmd_version(uint32_t sm_isa, uint32_t *spa, uint32_t *qmd)
+{
+   static const struct { uint16_t isa, spa; uint32_t qmd; } table[] = {
+      { 0x502, 0x502, 0 }, { 0x503, 0x503, 0 }, { 0x600, 0x505, 0 },
+      { 0x601, 0x505, 0 }, { 0x602, 0x506, 0 }, { 0x700, 0x700, 0 },
+      { 0x702, 0x702, 0 }, { 0x703, 0x703, 0 }, { 0x705, 0x705, 0 },
+      { 0x802, 0x802, 0 }, { 0x806, 0x806, 0 }, { 0x807, 0x806, 0 },
+      { 0x809, 0x809, 0 }, { 0x900, 0x900, 0x10040 },
+      { 0xa00, 0xa00, 0x10041 }, { 0xa01, 0xa01, 0x10041 },
+      { 0xa03, 0xa03, 0x10041 }, { 0xa04, 0xa04, 0x10050 },
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(table); i++) {
+      if (table[i].isa == sm_isa) {
+         *spa = table[i].spa;
+         *qmd = table[i].qmd;
+         return true;
+      }
+   }
+   *spa = 0x500;
+   *qmd = 0;
+   return false;
+}
