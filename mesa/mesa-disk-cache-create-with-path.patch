-bool
-disk_cache_enabled()
+/* Prepare a cache directory at an absolute path chosen by the caller instead
+ * of the location derived from MESA_SHADER_CACHE_DIR, XDG_CACHE_HOME or HOME
+ * (disk_cache_generate_cache_dir). The parent directory must exist; the last
+ * path component is created if it does not. The single-file cache gets the
+ * same driver_id/gpu_name subdirectories as in the default location.
+ *
+ * Returns NULL if the path is not absolute or cannot be used.
+ */
+const char *
+disk_cache_prepare_explicit_dir(void *mem_ctx, const char *path,
+                                const char *gpu_name, const char *driver_id,
+                                enum disk_cache_type cache_type)
+{
+   if (path[0] != '/')
+      return NULL;
+
+   if (find_or_mkdir_if_needed(path, true) == -1)
+      return NULL;
+
+   const char *dir = ralloc_strdup(mem_ctx, path);
+   if (!dir)
+      return NULL;
+
+   if (cache_type == DISK_CACHE_SINGLE_FILE) {
+      dir = concatenate_and_mkdir(mem_ctx, dir, driver_id, true);
+      if (!dir)
+         return NULL;
+
+      dir = concatenate_and_mkdir(mem_ctx, dir, gpu_name, true);
+   }
+
+   return dir;
+}
+
+static bool
+disk_cache_enabled_with_default(bool disable_by_default)
 {
    /* If running as a users other than the real user disable cache */
    if (!__normal_user())
       return false;
 
-   /* At user request, disable shader cache entirely.
-    * Disk cache is not enabled by default for android, for most
-    * applications the EGL layer uses EGL_ANDROID_blob_cache to manage
-    * the cache itself, however those that wish to use the cache directly
-    * can set `mesa.shader.cache.disable=false` property.
-    * Don't forget to also set the shader cache path to something readable
-    * and writable by the application via `mesa.shader.cache.dir`.
-    */
-#if defined(SHADER_CACHE_DISABLE_BY_DEFAULT) || DETECT_OS_ANDROID
-   bool disable_by_default = true;
-#else
-   bool disable_by_default = false;
-#endif
    char *envvar_name = "MESA_SHADER_CACHE_DISABLE";
 #if !DETECT_OS_ANDROID
    if (!os_get_option(envvar_name)) {
@@ -1116,6 +1137,35 @@ disk_cache_enabled()
    return true;
 }
 
+bool
+disk_cache_enabled()
+{
+   /* At user request, disable shader cache entirely.
+    * Disk cache is not enabled by default for android, for most
+    * applications the EGL layer uses EGL_ANDROID_blob_cache to manage
+    * the cache itself, however those that wish to use the cache directly
+    * can set `mesa.shader.cache.disable=false` property.
+    * Don't forget to also set the shader cache path to something readable
+    * and writable by the application via `mesa.shader.cache.dir`.
+    */
+#if defined(SHADER_CACHE_DISABLE_BY_DEFAULT) || DETECT_OS_ANDROID
+   bool disable_by_default = true;
+#else
+   bool disable_by_default = false;
+#endif
+   return disk_cache_enabled_with_default(disable_by_default);
+}
+
+/* A cache the caller placed at an explicit path (disk_cache_create_with_path)
+ * is an opt-in by itself: only an explicit MESA_SHADER_CACHE_DISABLE (or
+ * running as another user) turns it off, on every platform.
+ */
+bool
+disk_cache_enabled_for_explicit_path(void)
+{
+   return disk_cache_enabled_with_default(false);
+}
