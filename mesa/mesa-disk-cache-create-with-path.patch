+ */
+static bool
+disk_cache_type_and_max_size(enum disk_cache_type *type, uint64_t *max_size_out)
 {
    enum disk_cache_type cache_type;
-   struct disk_cache *cache;
    uint64_t max_size = 0;
    const char *max_size_str;
 
