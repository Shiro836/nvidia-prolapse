+
+struct disk_cache *
+disk_cache_create(const char *gpu_name, const char *driver_id,
+                  uint64_t driver_flags)
+{
+   enum disk_cache_type cache_type;
+   struct disk_cache *cache;
+   uint64_t max_size;
+
+   if (!disk_cache_type_and_max_size(&cache_type, &max_size))
+      return NULL;
+
+   /* Since switching the default cache to <mesa_shader_cache_db>, remove the
+    * old cache folder if it hasn't been modified for more than 7 days.
+    */
+   if (cache_type == DISK_CACHE_DATABASE &&
+       !os_get_option("MESA_SHADER_CACHE_DIR") && !os_get_option("MESA_GLSL_CACHE_DIR") &&
+       disk_cache_enabled())
+      disk_cache_delete_old_cache();
+
    /* Create main writable cache. */
-   cache = disk_cache_type_create(gpu_name, driver_id, NULL, driver_flags,
+   cache = disk_cache_type_create(gpu_name, driver_id, NULL, NULL, driver_flags,
                                   cache_type, max_size);
    if (!cache)
       return NULL;
@@ -306,7 +331,7 @@ disk_cache_create(const char *gpu_name, const char *driver_id,
        * will be bypassed.
        */
       cache->foz_ro_cache = disk_cache_type_create(gpu_name, driver_id, NULL,
-                                                   driver_flags,
+                                                   NULL, driver_flags,
                                                    DISK_CACHE_SINGLE_FILE,
                                                    max_size);
    }
@@ -314,12 +339,36 @@ disk_cache_create(const char *gpu_name, const char *driver_id,
    return cache;
 }
 
+/* Like disk_cache_create(), but the cache lives in the directory `path` (an
+ * absolute path; the last component is created if missing) instead of the
+ * location derived from MESA_SHADER_CACHE_DIR, XDG_CACHE_HOME or HOME, and it
+ * is enabled on every platform unless MESA_SHADER_CACHE_DISABLE is set: the
+ * caller choosing a directory is the opt-in. This is for drivers that know a
+ * private per-application directory the process-global options cannot name
+ * (e.g. an Android application's code cache). Cache type and size limit come
+ * from the same options as disk_cache_create(); unlike
+ * disk_cache_create_custom(), driver_flags are part of every key.
+ */
+struct disk_cache *
+disk_cache_create_with_path(const char *gpu_name, const char *driver_id,
+                            uint64_t driver_flags, const char *path)
+{
+   enum disk_cache_type cache_type;
+   uint64_t max_size;
+
+   if (!disk_cache_type_and_max_size(&cache_type, &max_size))
+      return NULL;
+
+   return disk_cache_type_create(gpu_name, driver_id, NULL, path, driver_flags,
+                                 cache_type, max_size);
+}
+
 struct disk_cache *
 disk_cache_create_custom(const char *gpu_name, const char *driver_id,
                          uint64_t driver_flags, const char *cache_dir_name,
                          uint32_t max_size)
 {
-   return disk_cache_type_create(gpu_name, driver_id, cache_dir_name, 0,
+   return disk_cache_type_create(gpu_name, driver_id, cache_dir_name, NULL, 0,
                                  DISK_CACHE_DATABASE, max_size);
 }
 
