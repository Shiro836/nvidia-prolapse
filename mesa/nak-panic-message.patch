+// The message of the last panic caught by nak_compile_shader on this thread.
+// Where stderr is not visible (Android services write it to /dev/null) the
+// default hook's output is lost, so the caller can log it instead.
+thread_local! {
+    static LAST_PANIC: RefCell<Option<CString>> = const { RefCell::new(None) };
+}
+
+fn record_panics() {
+    static HOOK: Once = Once::new();
+    HOOK.call_once(|| {
+        let previous = panic::take_hook();
+        panic::set_hook(Box::new(move |info| {
+            let msg = info.to_string().replace('\0', " ");
+            LAST_PANIC.with(|p| *p.borrow_mut() = CString::new(msg).ok());
+            previous(info);
+        }));
+    });
+}
+
 #[no_mangle]
 pub extern "C" fn nak_compile_shader(
     nir: *mut nir_shader,
@@ -576,6 +596,19 @@ pub extern "C" fn nak_compile_shader(
     if DEBUG.panic() {
         compile()
     } else {
+        record_panics();
+        LAST_PANIC.with(|p| *p.borrow_mut() = None);
         panic::catch_unwind(compile).unwrap_or(std::ptr::null_mut())
     }
 }
+
+/// The panic message (with location) of the last nak_compile_shader call on
+/// this thread that returned NULL, or NULL. Valid until the next
+/// nak_compile_shader call on the same thread.
+#[no_mangle]
+pub extern "C" fn nak_compile_shader_panic_message() -> *const c_char {
+    LAST_PANIC.with(|p| match &*p.borrow() {
+        Some(msg) => msg.as_ptr(),
+        None => std::ptr::null(),
+    })
+}
