@@ -284,6 +284,10 @@ nak_compile_shader(nir_shader *nir, bool dump_asm,
                    const struct nak_fs_key *fs_key,
                    bool has_task_shader);
 
+/* Panic message (with source location) of the last nak_compile_shader call on
+ * this thread that returned NULL, or NULL. Valid until the next call. */
+const char *nak_compile_shader_panic_message(void);
