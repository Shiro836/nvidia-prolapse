+/// Waits until scoreboard `sb` counts at most `count` outstanding
+/// operations (Volta+ DEPBAR.LE).  A scoreboard counts every in-flight
+/// operation that signals it, so when the operations signalling one
+/// scoreboard complete in issue order, `count` = the number of them issued
+/// after the one being waited for.
+#[repr(C)]
+#[derive(SrcsAsSlice, DstsAsSlice)]
+pub struct OpDepBar {
+    pub sb: u8,
+    pub count: u8,
+}
+
+impl DisplayOp for OpDepBar {
+    fn fmt_op(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "depbar.le sb{}, {}", self.sb, self.count)
+    }
+}
+impl_display_for_op!(OpDepBar);
