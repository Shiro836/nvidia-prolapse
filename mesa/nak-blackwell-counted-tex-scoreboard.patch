+impl SM70Op for OpDepBar {
+    fn legalize(&mut self, _b: &mut LegalizeBuilder) {
+        // Nothing to do
+    }
+
+    fn encode(&self, e: &mut SM70Encoder<'_>) {
+        // DEPBAR.LE SBn, count: count in bits 38..44, scoreboard in 44..47,
+        // bit 47 selects the .LE (counter <= count) form, as NVIDIA's
+        // compiler encodes it on GB20x (e.g. 0x...0d1800000791a =
+        // DEPBAR.LE SB5, 0x6).
+        e.set_opcode(0x91a);
+        e.set_field(38..44, self.count);
+        e.set_field(44..47, self.sb);
+        e.set_bit(47, true);
+    }
+}
