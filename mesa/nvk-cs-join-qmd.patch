+/* One QMD of the compute dependency chain: an empty QMD loaded inline from
+ * the push buffer, patched in place until the command buffer ends.
+ */
+struct nvk_cs_join_qmd {
+   uint64_t addr;
+   uint32_t *map;
+   uint32_t counter;
+   bool valid;
+};
+
+/* Compute -> compute ordering through QMD dependencies instead of
+ * WAIT_FOR_IDLE, as NVIDIA's driver does it (libnvidia-eglcore.so
+ * 615.78.08: per-dispatch hook E 0xd35a90, join QMD E 0xd345d0, consumer
+ * link E 0xd33fb0, launch kick E 0xd36060).  Every dispatch decrements the
+ * open join QMD when it completes; a barrier makes the next dispatch wait
+ * for that join QMD.  The state never crosses a command buffer boundary.
+ */
+struct nvk_cs_join {
+   /* The open join QMD every dispatch since the last barrier decrements */
+   struct nvk_cs_join_qmd join;
+   /* The join QMD of the last barrier and the newest empty link QMD hung
+    * below it: the next dispatch waits on the newest of the two.
+    */
+   struct nvk_cs_join_qmd prev;
+   struct nvk_cs_join_qmd link;
+   /* Dispatches linked to the open join QMD */
+   uint32_t linked;
+   /* Dispatches and QMDs since the chain was last drained with methods */
+   uint32_t chain;
+   /* A barrier is pending: the next dispatch releases the join QMD */
+   bool barrier;
+   /* Invalidates the pending barrier's destination needs */
+   bool inval_tex, inval_data, inval_const;
+};
+
 struct nvk_cmd_push {
    void *map;
    uint64_t addr;
@@ -235,6 +270,19 @@ struct nvk_cmd_push {
