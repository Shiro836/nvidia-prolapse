+    * would never arrive, so no dispatch joins the chain while it can be on.
+    */
+   bool cs_join_cond_render;
+   /* All compute work recorded so far is either complete when the open join
+    * QMD chain starts or part of the chain: only then can a barrier wait on
+    * the chain alone.  Set by a compute-subchannel drain, cleared by compute
+    * work that is not linked and at the start of the command buffer (an
+    * earlier command buffer's dispatches may still be running).
+    */
+   bool cs_join_covered;
+
    struct nvk_cmd_state {
       uint64_t descriptor_buffers[NVK_MAX_SETS];
       struct nvk_graphics_state gfx;
