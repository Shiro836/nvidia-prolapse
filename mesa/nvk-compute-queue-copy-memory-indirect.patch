+static bool
+nvk_cmd_counter_target(struct nvk_cmd_buffer *cmd,
+                       uint64_t *addr, uint32_t *count)
+{
+   const struct nvk_physical_device *pdev =
+      nvk_device_physical(nvk_cmd_buffer_device(cmd));
+   if (nvk_cmd_sked_qmds_tracked(pdev)) {
+      if (cmd->sked.counter_addr == 0 || cmd->sked.wfi_drain)
+         return false;
+      *addr = cmd->sked.counter_addr;
+      *count = cmd->sked.launches;
+      return true;
+   }
+   if (!cmd->cntr.started)
