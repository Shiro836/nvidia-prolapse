+   __push_mthd(p, nvk_cmd_buffer_host_subc(cmd), NVC86F_SEM_ADDR_LO);
+   P_NVC86F_SEM_ADDR_LO(p, (uint32_t)addr >> 2);
+   P_NVC86F_SEM_ADDR_HI(p, addr >> 32);
