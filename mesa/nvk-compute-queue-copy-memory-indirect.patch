+{
+   if (cmd->push.end != cmd->cntr.mark)
+      cmd->cntr.other_work = true;
+}
+
+void
+nvk_cmd_counted_launches_end(struct nvk_cmd_buffer *cmd, uint32_t count)
+{
+   cmd->cntr.pending += count;
+   cmd->cntr.mark = cmd->push.end;
