--- /dev/null
+++ b/src/nouveau/vulkan/nvk_pascal_a.h
@@ -0,0 +1,63 @@
+/*
+ * Copyright © 2026 waydroid-nvidia-prolapse contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NVK_PASCAL_A_H
+#define NVK_PASCAL_A_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "nv_push.h"
+#include "clc097.h"
+
+/*
+ * PASCAL_A (GP100/GP10B) 3D clear bracket. The NVIDIA 580 userspace driver
+ * brackets every 3D clear on PASCAL_A with two undocumented 3D methods:
+ * 0xF60 := 1 before the first clear word, then 0xF80 := 1 and 0xF60 := 0
+ * after the last one. PASCAL_B (GP10x), Maxwell and Volta+ never get this
+ * bracket. Interface observation of libnvidia-eglcore.so.580.178.04 (static,
+ * objdump): gate `arch & 0xa00` (PASCAL_A) at ELF 0xb5b1a1 / 0xb5b81a /
+ * 0xb5b870, prefix store 0x800103d8 at 0xb5b8f7, suffix pair
+ * 0x800003d8800103e0 at 0xb5b881, CLEAR_SURFACE words between them. The
+ * methods are not in the public class headers; their meaning is unknown.
+ */
+#define NVK_PASCAL_A_MTHD_F60 0x0f60
+#define NVK_PASCAL_A_MTHD_F80 0x0f80
+
+static inline bool
+nvk_pascal_a_clear_bracket(uint16_t cls_eng3d)
+{
+   return cls_eng3d == PASCAL_A;
+}
+
+/* Number of dwords nvk_push_pascal_a_clear_{begin,end} push. */
+static inline uint32_t
+nvk_pascal_a_clear_begin_dw(uint16_t cls_eng3d)
+{
+   return nvk_pascal_a_clear_bracket(cls_eng3d) ? 1 : 0;
+}
+
+static inline uint32_t
+nvk_pascal_a_clear_end_dw(uint16_t cls_eng3d)
+{
+   return nvk_pascal_a_clear_bracket(cls_eng3d) ? 2 : 0;
+}
+
+static inline void
+nvk_push_pascal_a_clear_begin(struct nv_push *p, uint16_t cls_eng3d)
+{
+   if (nvk_pascal_a_clear_bracket(cls_eng3d))
+      __push_immd(p, SUBC_NV9097, NVK_PASCAL_A_MTHD_F60, 1);
+}
+
+static inline void
+nvk_push_pascal_a_clear_end(struct nv_push *p, uint16_t cls_eng3d)
+{
+   if (nvk_pascal_a_clear_bracket(cls_eng3d)) {
+      __push_immd(p, SUBC_NV9097, NVK_PASCAL_A_MTHD_F80, 1);
+      __push_immd(p, SUBC_NV9097, NVK_PASCAL_A_MTHD_F60, 0);
+   }
+}
+
+#endif /* NVK_PASCAL_A_H */
