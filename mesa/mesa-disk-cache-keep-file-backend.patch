From ce565e51d88cd9bbb85c8f6f6c1cd85a18d8c1fb Mon Sep 17 00:00:00 2001
From: nvidia-prolapse <nvidia-prolapse@localhost>
Date: Sat, 17 Oct 2026 15:30:01 +0300
Subject: [PATCH 2/3] util/disk_cache: keep a working file backend when
 callbacks are set

EGL_ANDROID_blob_cache callbacks replace the disk cache's storage for every
get, put, put_key and has_key. On Android libEGL installs them on every
display whose driver advertises the extension, and egl_dri2 advertises it
whenever the screen has get_disk_shader_cache. A cache the driver created
with a file backend on purpose (disk_cache_create_with_path(), or
MESA_SHADER_CACHE_DISABLE=false) was therefore silently redirected into the
platform's blob cache (64 KiB per value, 2 MiB per application on Android
13, random eviction).

Ignore the callbacks when the cache already has a working file backend.
Caches without one (the default on Android) take them as before.
---
 src/util/disk_cache.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/util/disk_cache.c b/src/util/disk_cache.c
index 4f15be7..e4f6fe7 100644
--- a/src/util/disk_cache.c
+++ b/src/util/disk_cache.c
@@ -751,6 +751,15 @@ void
 disk_cache_set_callbacks(struct disk_cache *cache, disk_cache_put_cb put,
                          disk_cache_get_cb get)
 {
+   /* Callbacks take over every get and put, so a cache that has a working
+    * file backend keeps it and ignores them. Such a cache was enabled
+    * explicitly (by default only caches without one, e.g. on Android, are
+    * handed callbacks); redirecting it into the callbacks' store would
+    * silently replace the storage that was asked for.
+    */
+   if (cache->type != DISK_CACHE_NONE && !cache->path_init_failed)
+      return;
+
    cache->blob_put_cb = put;
    cache->blob_get_cb = get;
    disk_cache_init_queue(cache);
