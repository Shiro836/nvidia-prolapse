#version 450
// GTA San Andreas (Android 2.11) vehicle vertex shader specular term as ANGLE
// translates it (GLSL.std.450 Pow + FMax, no float-controls execution modes):
//   spec = max(pow(dot(reflVector, DirLightDirection), 10.0), 0.0) * MaterialSpecular * 2.0
// and the FClamp variant. pow(x < 0, y) is NaN on NVIDIA (exp2(y * log2(x))).
layout(local_size_x = 4) in;
layout(std430, set = 0, binding = 0) buffer Data {
   float d[4];
   float o_max[4];
   float o_clamp[4];
   float o_min[4];
};
void main()
{
   uint i = gl_LocalInvocationID.x;
   float p = pow(d[i], 10.0);
   o_max[i] = max(p, 0.0) * 2.0;
   o_clamp[i] = clamp(p, 0.0, 1.0);
   o_min[i] = min(-p, 0.0);
}
