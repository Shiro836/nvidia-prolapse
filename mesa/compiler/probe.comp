#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Output { uint value[]; } output_data;
layout(push_constant) uniform Constants { uint multiplier; uint addend; uint count; } constants;
void main() {
  uint i=gl_GlobalInvocationID.x;
  if(i<constants.count) output_data.value[i]=i*constants.multiplier+constants.addend;
}
