+/* vkCmdClearColorImage on a queue without the 3D class (the compute-only
+ * family).  The proprietary driver clears an image there with its compute
+ * fill kernel over the image's bytes (libnvidia-eglcore.so 615.78.08 on its
+ * compute-queue channel: an inline-to-memory parameter block holding a
+ * 16-byte pattern, then one inline-QMD launch of the same kernel it uses for
+ * vkCmdFillBuffer, over 256x256x4 bytes for a 256x256 RGBA8 image).  A
+ * colour subresource's elements are a permutation of its bytes in any
+ * tiling, so filling every byte of each cleared level and layer with the
+ * packed clear value repeated clears it.  The kernel below stores one word
+ * of a 16-byte pattern per invocation.
+ */
+#define NVK_META_OBJECT_KEY_FILL_PATTERN16 (VK_META_OBJECT_KEY_DRIVER_OFFSET + 0x100)
+
+struct nvk_meta_fill16_push {
+   uint64_t addr;
+   uint32_t size_B;
+   uint32_t pad;
+   uint32_t pattern[4];
+};
+
+#define NVK_META_FILL16_WG_SIZE 128
+
+static nir_shader *
+nvk_meta_build_fill16_shader(void)
+{
+   nir_builder builder =
+      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, NULL,
+                                     "nvk-meta-fill-pattern16");
+   nir_builder *b = &builder;
+   b->shader->info.workgroup_size[0] = NVK_META_FILL16_WG_SIZE;
+   b->shader->info.workgroup_size[1] = 1;
+   b->shader->info.workgroup_size[2] = 1;
+
+   nir_def *id = nir_channel(b, nir_load_global_invocation_id(b, 32), 0);
+   nir_def *offset = nir_imul_imm(b, id, 4);
+   nir_def *size = nir_load_push_constant(b, 1, 32,
+      nir_imm_int(b, offsetof(struct nvk_meta_fill16_push, size_B)));
+
+   nir_push_if(b, nir_ult(b, offset, size));
+   {
+      nir_def *addr = nir_load_push_constant(b, 1, 64,
+         nir_imm_int(b, offsetof(struct nvk_meta_fill16_push, addr)));
+      /* Word (offset / 4) % 4 of the pattern; the range starts on a
+       * 16-byte boundary, so the pattern phase is the byte offset's.
+       */
+      nir_def *pattern = nir_load_push_constant(b, 4, 32,
+         nir_imm_int(b, offsetof(struct nvk_meta_fill16_push, pattern)));
+      nir_def *word = nir_vector_extract(b, pattern,
+                                         nir_iand_imm(b, id, 3));
+      nir_def *dst = nir_iadd(b, addr, nir_u2u64(b, offset));
+
+      nir_push_if(b, nir_uge(b, size, nir_iadd_imm(b, offset, 4)));
+      {
+         nir_store_global(b, word, dst, .align_mul = 4);
+      }
+      nir_push_else(b, NULL);
+      {
+         /* A pitch-linear level of 8/16-bit elements may end inside a
+          * word: store its last bytes one by one.
+          */
+         for (unsigned i = 1; i < 4; i++) {
+            nir_push_if(b, nir_ult(b, nir_iadd_imm(b, offset, i - 1), size));
+            nir_store_global(b, nir_u2u8(b, nir_ushr_imm(b, word, 8 * (i - 1))),
+                             nir_iadd_imm(b, dst, i - 1), .align_mul = 1);
+            nir_pop_if(b, NULL);
+         }
+      }
+      nir_pop_if(b, NULL);
+   }
+   nir_pop_if(b, NULL);
+
+   return b->shader;
+}
+
+static VkResult
+nvk_meta_get_fill16_pipeline(struct nvk_device *dev,
+                             VkPipelineLayout *layout_out,
+                             VkPipeline *pipeline_out)
+{
+   const enum vk_meta_object_key_type key = NVK_META_OBJECT_KEY_FILL_PATTERN16;
+
+   const VkPushConstantRange push_range = {
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      .offset = 0,
+      .size = sizeof(struct nvk_meta_fill16_push),
+   };
+   VkResult result = vk_meta_get_pipeline_layout(&dev->vk, &dev->meta, NULL,
+                                                 &push_range, &key,
+                                                 sizeof(key), layout_out);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkPipeline cached = vk_meta_lookup_pipeline(&dev->meta, &key, sizeof(key));
+   if (cached != VK_NULL_HANDLE) {
+      *pipeline_out = cached;
+      return VK_SUCCESS;
+   }
+
+   const VkPipelineShaderStageNirCreateInfoMESA nir_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+      .nir = nvk_meta_build_fill16_shader(),
+   };
+   const VkComputePipelineCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .pNext = &nir_info,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .pName = "main",
+      },
+      .layout = *layout_out,
+   };
+   result = vk_meta_create_compute_pipeline(&dev->vk, &dev->meta, &info,
+                                            &key, sizeof(key), pipeline_out);
+   ralloc_free(nir_info.nir);
+   return result;
+}
+
+static void
+nvk_meta_fill16(struct nvk_cmd_buffer *cmd, VkPipelineLayout layout,
+                uint64_t addr, uint64_t size_B, const uint32_t pattern[4])
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   const struct vk_device_dispatch_table *disp = &dev->vk.dispatch_table;
+   const uint64_t per_dispatch_B =
+      (uint64_t)pdev->vk.properties.maxComputeWorkGroupCount[0] *
+      NVK_META_FILL16_WG_SIZE * 4;
+
+   while (size_B > 0) {
+      /* Whole 16-byte periods per chunk keep the next chunk in phase */
+      const uint32_t chunk_B = MIN3(size_B, per_dispatch_B, 1u << 30);
+      struct nvk_meta_fill16_push push = {
+         .addr = addr,
+         .size_B = chunk_B,
+      };
+      memcpy(push.pattern, pattern, sizeof(push.pattern));
+      disp->CmdPushConstants(nvk_cmd_buffer_to_handle(cmd), layout,
+                             VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push),
+                             &push);
+      disp->CmdDispatch(nvk_cmd_buffer_to_handle(cmd),
+                        DIV_ROUND_UP(chunk_B, NVK_META_FILL16_WG_SIZE * 4),
+                        1, 1);
+      addr += chunk_B;
+      size_B -= chunk_B;
+   }
+}
+
+void
+nvk_cmd_clear_color_image_meta(struct nvk_cmd_buffer *cmd,
+                               struct nvk_image *image,
+                               const VkClearColorValue *color,
+                               uint32_t range_count,
+                               const VkImageSubresourceRange *ranges)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   VkFormat vk_format = image->vk.format;
+   if (vk_format == VK_FORMAT_R64_UINT || vk_format == VK_FORMAT_R64_SINT)
+      vk_format = VK_FORMAT_R32G32_UINT;
+   const enum pipe_format p_format = nvk_format_to_pipe_format(vk_format);
+   const unsigned blk_B = util_format_get_blocksize(p_format);
+
+   /* The fill covers whole elements of one plane in place: a pattern period
+    * that divides 16 bytes, no YCbCr planes, no linear image whose data
+    * lives in a tiled shadow.
+    */
+   if (image->plane_count != 1 || 16 % blk_B != 0 ||
+       util_format_is_compressed(p_format) ||
+       image->linear_tiled_shadows[0].nil.size_B > 0) {
+      vk_command_buffer_set_error(&cmd->vk,
+         vk_errorf(cmd, VK_ERROR_UNKNOWN,
+                   "vkCmdClearColorImage on the compute-only queue family: "
+                   "format %s (%u-byte elements, %u planes%s) has no compute "
+                   "fill clear", util_format_short_name(p_format), blk_B,
+                   image->plane_count,
+                   image->linear_tiled_shadows[0].nil.size_B > 0 ?
+                   ", linear with a tiled shadow" : ""));
+      return;
+   }
+
+   uint8_t element[16] = { 0 };
+   util_format_pack_rgba(p_format, element, color->uint32, 1);
+   uint32_t pattern[4];
+   for (unsigned i = 0; i < 16; i += blk_B)
+      memcpy((uint8_t *)pattern + i, element, blk_B);
+
+   VkPipelineLayout layout;
+   VkPipeline pipeline;
+   VkResult result = nvk_meta_get_fill16_pipeline(dev, &layout, &pipeline);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   struct nvk_meta_save_compute save;
+   nvk_meta_begin_compute(cmd, &save);
+   dev->vk.dispatch_table.CmdBindPipeline(nvk_cmd_buffer_to_handle(cmd),
+                                          VK_PIPELINE_BIND_POINT_COMPUTE,
+                                          pipeline);
+
+   const struct nvk_image_plane *plane = &image->planes[0];
+   const uint64_t base = nvk_image_plane_base_address(plane);
+   for (uint32_t r = 0; r < range_count; r++) {
+      const uint32_t level_count =
+         vk_image_subresource_level_count(&image->vk, &ranges[r]);
+      const uint32_t layer_count =
+         vk_image_subresource_layer_count(&image->vk, &ranges[r]);
+      for (uint32_t l = 0; l < level_count; l++) {
+         const uint32_t level = ranges[r].baseMipLevel + l;
+         const uint64_t level_B =
+            nil_image_level_layer_size_B(&plane->nil, level);
+         for (uint32_t a = 0; a < layer_count; a++) {
+            const uint32_t layer = ranges[r].baseArrayLayer + a;
+            const uint64_t addr = base +
+               nil_image_level_layer_offset_B(&plane->nil, level, layer);
+            /* Levels start on whole GOBs, pitch-linear ones on their
+             * row-pitch alignment.
+             */
+            assert(addr % 16 == 0);
+            nvk_meta_fill16(cmd, layout, addr, level_B, pattern);
+         }
+      }
+   }
+
+   nvk_meta_end_compute(cmd, &save);
+}
+
+void
+nvk_cmd_update_buffer_meta(struct nvk_cmd_buffer *cmd, VkBuffer dstBuffer,
+                           VkDeviceSize dstOffset, VkDeviceSize dataSize,
+                           const void *pData)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   struct nvk_meta_save_compute save;
+   nvk_meta_begin_compute(cmd, &save);
+   vk_meta_update_buffer(&cmd->vk, &dev->meta, dstBuffer, dstOffset,
+                         dataSize, pData);
+   nvk_meta_end_compute(cmd, &save);
+}
