+      nir_def *row_stride = nir_load_push_constant(b, 1, 32,
+         nir_imm_int(b, offsetof(struct nvk_meta_blocks_to_buffer_push, row_stride_B)));
+      nir_def *byte_off =
+         nir_iadd(b, nir_imul(b, nir_channel(b, id, 1), row_stride),
+                     nir_imul_imm(b, nir_channel(b, id, 0), block_B));
+      nir_def *addr = nir_iadd(b, buf_addr, nir_u2u64(b, byte_off));
+
+      if (to_image) {
+         nir_def *block = nir_load_global(b, block_B / 4, 32, addr,
+                                          .align_mul = 4);
+         nir_def *zero = nir_imm_int(b, 0);
+         nir_def *val = nir_pad_vector_imm_int(b, block, 0, 4);
+         nir_image_deref_store(b, &res->def,
+                               nir_vec4(b, nir_channel(b, coord, 0),
+                                        nir_channel(b, coord, 1), zero, zero),
+                               zero, val, zero,
+                               .image_dim = GLSL_SAMPLER_DIM_2D,
+                               .image_array = false, .format = view_pfmt,
+                               .access = ACCESS_NON_READABLE,
+                               .src_type = nir_type_uint32);
+      } else {
+         nir_def *texel = nir_txf(b, coord, .texture_deref = res);
+         nir_store_global(b, nir_trim_vector(b, texel, block_B / 4), addr,
+                          .align_mul = 4);
+      }
+   }
+   nir_pop_if(b, NULL);
+
+   return b->shader;
+}
+
+static VkResult
+nvk_meta_get_blocks_to_buffer_pipeline(struct nvk_device *dev,
+                                       uint32_t block_B, bool to_image,
+                                       VkPipelineLayout *layout_out,
+                                       VkPipeline *pipeline_out)
+{
+   struct nvk_meta_blocks_to_buffer_key key;
+   memset(&key, 0, sizeof(key));
+   key.key_type = NVK_META_OBJECT_KEY_COMPRESSED_TO_BUFFER;
+   key.block_B = block_B;
+   key.to_image = to_image;
+
+   /* One layout per direction: the descriptor type differs */
+   const struct {
+      enum vk_meta_object_key_type key_type;
+      bool to_image;
+   } layout_key = { key.key_type, to_image };
+
+   const VkDescriptorSetLayoutBinding binding = {
+      .binding = 0,
+      .descriptorType = to_image ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                                 : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+      .descriptorCount = 1,
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+   };
+   const VkDescriptorSetLayoutCreateInfo set_layout = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+      .bindingCount = 1,
+      .pBindings = &binding,
+   };
+   const VkPushConstantRange push_range = {
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      .offset = 0,
+      .size = sizeof(struct nvk_meta_blocks_to_buffer_push),
+   };
+   VkResult result = vk_meta_get_pipeline_layout(&dev->vk, &dev->meta,
+                                                 &set_layout, &push_range,
+                                                 &layout_key,
+                                                 sizeof(layout_key),
+                                                 layout_out);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkPipeline cached = vk_meta_lookup_pipeline(&dev->meta, &key, sizeof(key));
+   if (cached != VK_NULL_HANDLE) {
+      *pipeline_out = cached;
+      return VK_SUCCESS;
+   }
+
+   const VkPipelineShaderStageNirCreateInfoMESA nir_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+      .nir = nvk_meta_build_blocks_to_buffer_shader(block_B, to_image),
+   };
+   const VkComputePipelineCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .pNext = &nir_info,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .pName = "main",
+      },
+      .layout = *layout_out,
+   };
+   result = vk_meta_create_compute_pipeline(&dev->vk, &dev->meta, &info,
+                                            &key, sizeof(key), pipeline_out);
+   ralloc_free(nir_info.nir);
+   return result;
+}
+
+/* One compute pass per (region, layer) between a buffer and single-layer
+ * views of a compressed image; to_image selects the direction.
+ */
+static void
+nvk_cmd_copy_compressed_layers(struct nvk_cmd_buffer *cmd, bool to_image,
+                               VkImage image, VkImageLayout image_layout,
+                               VkBuffer buffer, uint32_t region_count,
+                               const VkBufferImageCopy2 *regions)
+{
+   VK_FROM_HANDLE(nvk_image, src, image);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct vk_device_dispatch_table *disp = &dev->vk.dispatch_table;
+   const VkCommandBuffer handle = nvk_cmd_buffer_to_handle(cmd);
+
+   const uint32_t block_B = vk_format_get_blocksize(src->vk.format);
+   assert(block_B == 8 || block_B == 16);
+   const VkFormat view_format = block_B == 8 ? VK_FORMAT_R32G32_UINT
+                                             : VK_FORMAT_R32G32B32A32_UINT;
+
+   VkPipelineLayout layout;
+   VkPipeline pipeline;
+   VkResult result =
+      nvk_meta_get_blocks_to_buffer_pipeline(dev, block_B, to_image,
+                                             &layout, &pipeline);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   struct nvk_meta_save_compute save;
+   nvk_meta_begin_compute(cmd, &save);
+   disp->CmdBindPipeline(handle, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+
+   for (uint32_t r = 0; r < region_count; r++) {
+      const VkBufferImageCopy2 *region = &regions[r];
+      const struct vk_image_buffer_layout buf_layout =
+         vk_image_buffer_copy_layout(&src->vk, region);
+      const VkExtent3D extent_el =
+         vk_image_extent_to_elements(&src->vk, region->imageExtent);
+      const VkOffset3D offset_el =
+         vk_image_offset_to_elements(&src->vk, region->imageOffset);
+      const uint32_t layer_count =
+         vk_image_subresource_layer_count(&src->vk, &region->imageSubresource);
+
+      for (uint32_t l = 0; l < layer_count; l++) {
+         const VkImageViewUsageCreateInfo usage = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO,
+            .usage = to_image ? VK_IMAGE_USAGE_STORAGE_BIT
+                              : VK_IMAGE_USAGE_SAMPLED_BIT,
+         };
+         const VkImageViewCreateInfo view_info = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+            .pNext = &usage,
+            .flags = VK_IMAGE_VIEW_CREATE_DRIVER_INTERNAL_BIT_MESA,
+            .image = image,
+            .viewType = VK_IMAGE_VIEW_TYPE_2D,
+            .format = view_format,
+            .subresourceRange = {
+               .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+               .baseMipLevel = region->imageSubresource.mipLevel,
+               .levelCount = 1,
+               .baseArrayLayer = region->imageSubresource.baseArrayLayer + l,
+               .layerCount = 1,
+            },
+         };
+         VkImageView view;
+         result = vk_meta_create_image_view(&cmd->vk, &dev->meta, &view_info,
+                                            &view);
+         if (result != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, result);
+            break;
+         }
+
+         const VkWriteDescriptorSet write = {
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstBinding = 0,
+            .descriptorCount = 1,
+            .descriptorType = to_image ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE
+                                       : VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+            .pImageInfo = &(VkDescriptorImageInfo) {
+               .imageView = view,
+               .imageLayout = image_layout,
+            },
+         };
+         disp->CmdPushDescriptorSetKHR(handle, VK_PIPELINE_BIND_POINT_COMPUTE,
+                                    layout, 0, 1, &write);
+
+         const struct nvk_meta_blocks_to_buffer_push push = {
+            .buf_addr = vk_meta_buffer_address(&dev->vk, buffer,
+                                               region->bufferOffset +
+                                               l * buf_layout.image_stride_B,
+                                               VK_WHOLE_SIZE),
+            .row_stride_B = buf_layout.row_stride_B,
+            .offset_el = { offset_el.x, offset_el.y },
+            .extent_el = { extent_el.width, extent_el.height },
+         };
+         disp->CmdPushConstants(handle, layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                                0, sizeof(push), &push);
+         disp->CmdDispatch(handle, DIV_ROUND_UP(extent_el.width, 16),
+                           DIV_ROUND_UP(extent_el.height, 16), 1);
+      }
+   }
+
+   nvk_meta_end_compute(cmd, &save);
+}
+
+#define NVK_META_OBJECT_KEY_COMPRESSED_IMAGE_COPY (VK_META_OBJECT_KEY_DRIVER_OFFSET + 0x102)
+
+struct nvk_meta_layer_copy_key {
+   enum vk_meta_object_key_type key_type;
+   uint32_t block_B;
+};
+
+struct nvk_meta_layer_copy_push {
+   int32_t src_offset_el[2];
+   int32_t dst_offset_el[2];
+   uint32_t extent_el[2];
+};
+
+/* Image-to-image counterpart of nvk_cmd_copy_compressed_layers(): one
+ * single-layer sampled source view and one single-layer storage destination
+ * view per layer, both unsigned-integer views of the element size.
+ */
+static nir_shader *
+nvk_meta_build_layer_copy_shader(uint32_t block_B)
+{
+   nir_builder builder =
+      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, NULL,
+                                     "nvk-meta-compressed-layer-copy");
+   nir_builder *b = &builder;
+   b->shader->info.workgroup_size[0] = 16;
+   b->shader->info.workgroup_size[1] = 16;
+   b->shader->info.workgroup_size[2] = 1;
+
+   nir_variable *src_var =
+      nir_variable_create(b->shader, nir_var_uniform,
+                          glsl_texture_type(GLSL_SAMPLER_DIM_2D, false,
+                                            GLSL_TYPE_UINT), "src");
+   src_var->data.descriptor_set = 0;
+   src_var->data.binding = 0;
+   nir_variable *dst_var =
+      nir_variable_create(b->shader, nir_var_uniform,
+                          glsl_image_type(GLSL_SAMPLER_DIM_2D, false,
+                                          GLSL_TYPE_UINT), "dst");
+   dst_var->data.descriptor_set = 0;
+   dst_var->data.binding = 1;
+
+   const enum pipe_format view_pfmt =
+      vk_format_to_pipe_format(vk_meta_get_uint_format_for_blk_size(block_B));
+
+   nir_def *id = nir_trim_vector(b, nir_load_global_invocation_id(b, 32), 2);
+   nir_def *extent = nir_load_push_constant(b, 2, 32,
+      nir_imm_int(b, offsetof(struct nvk_meta_layer_copy_push, extent_el)));
+   nir_def *inside = nir_iand(b, nir_ult(b, nir_channel(b, id, 0),
+                                         nir_channel(b, extent, 0)),
+                                 nir_ult(b, nir_channel(b, id, 1),
+                                         nir_channel(b, extent, 1)));
+   nir_push_if(b, inside);
+   {
+      nir_def *src_off = nir_load_push_constant(b, 2, 32,
+         nir_imm_int(b, offsetof(struct nvk_meta_layer_copy_push, src_offset_el)));
+      nir_def *dst_off = nir_load_push_constant(b, 2, 32,
+         nir_imm_int(b, offsetof(struct nvk_meta_layer_copy_push, dst_offset_el)));
+      nir_def *texel = nir_txf(b, nir_iadd(b, id, src_off),
+                               .texture_deref = nir_build_deref_var(b, src_var));
+      nir_def *dst = nir_iadd(b, id, dst_off);
+      nir_def *zero = nir_imm_int(b, 0);
+      nir_image_deref_store(b, &nir_build_deref_var(b, dst_var)->def,
+                            nir_vec4(b, nir_channel(b, dst, 0),
+                                     nir_channel(b, dst, 1), zero, zero),
+                            zero, texel, zero,
+                            .image_dim = GLSL_SAMPLER_DIM_2D,
+                            .image_array = false, .format = view_pfmt,
+                            .access = ACCESS_NON_READABLE,
+                            .src_type = nir_type_uint32);
+   }
+   nir_pop_if(b, NULL);
+
+   return b->shader;
+}
+
+static VkResult
+nvk_meta_get_layer_copy_pipeline(struct nvk_device *dev, uint32_t block_B,
+                                 VkPipelineLayout *layout_out,
+                                 VkPipeline *pipeline_out)
+{
+   struct nvk_meta_layer_copy_key key;
+   memset(&key, 0, sizeof(key));
+   key.key_type = NVK_META_OBJECT_KEY_COMPRESSED_IMAGE_COPY;
+   key.block_B = block_B;
+
+   const VkDescriptorSetLayoutBinding bindings[] = {
+      {
+         .binding = 0,
+         .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+         .descriptorCount = 1,
+         .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      },
+      {
+         .binding = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+         .descriptorCount = 1,
+         .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      },
+   };
+   const VkDescriptorSetLayoutCreateInfo set_layout = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR,
+      .bindingCount = ARRAY_SIZE(bindings),
+      .pBindings = bindings,
+   };
+   const VkPushConstantRange push_range = {
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      .offset = 0,
+      .size = sizeof(struct nvk_meta_layer_copy_push),
+   };
+   VkResult result = vk_meta_get_pipeline_layout(&dev->vk, &dev->meta,
+                                                 &set_layout, &push_range,
+                                                 &key.key_type,
+                                                 sizeof(key.key_type),
+                                                 layout_out);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkPipeline cached = vk_meta_lookup_pipeline(&dev->meta, &key, sizeof(key));
+   if (cached != VK_NULL_HANDLE) {
+      *pipeline_out = cached;
+      return VK_SUCCESS;
+   }
+
+   const VkPipelineShaderStageNirCreateInfoMESA nir_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+      .nir = nvk_meta_build_layer_copy_shader(block_B),
+   };
+   const VkComputePipelineCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .pNext = &nir_info,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .pName = "main",
+      },
+      .layout = *layout_out,
+   };
+   result = vk_meta_create_compute_pipeline(&dev->vk, &dev->meta, &info,
+                                            &key, sizeof(key), pipeline_out);
+   ralloc_free(nir_info.nir);
+   return result;
+}
+
+static VkResult
+nvk_meta_layer_view(struct nvk_cmd_buffer *cmd, VkImage image,
+                    VkFormat format, VkImageUsageFlags usage_bit,
+                    uint32_t level, uint32_t layer, VkImageView *view_out)
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const VkImageViewUsageCreateInfo usage = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO,
+      .usage = usage_bit,
+   };
+   const VkImageViewCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .pNext = &usage,
+      .flags = VK_IMAGE_VIEW_CREATE_DRIVER_INTERNAL_BIT_MESA,
+      .image = image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .baseMipLevel = level,
+         .levelCount = 1,
+         .baseArrayLayer = layer,
+         .layerCount = 1,
+      },
+   };
+   return vk_meta_create_image_view(&cmd->vk, &dev->meta, &info, view_out);
+}
+
+static void
+nvk_cmd_copy_compressed_image_layers(struct nvk_cmd_buffer *cmd,
+                                     const VkCopyImageInfo2 *info)
+{
+   VK_FROM_HANDLE(nvk_image, src, info->srcImage);
+   VK_FROM_HANDLE(nvk_image, dst, info->dstImage);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct vk_device_dispatch_table *disp = &dev->vk.dispatch_table;
+   const VkCommandBuffer handle = nvk_cmd_buffer_to_handle(cmd);
+
+   const uint32_t block_B = vk_format_get_blocksize(src->vk.format);
+   assert(block_B == vk_format_get_blocksize(dst->vk.format));
+   const VkFormat view_format = vk_meta_get_uint_format_for_blk_size(block_B);
+
+   VkPipelineLayout layout;
+   VkPipeline pipeline;
+   VkResult result =
+      nvk_meta_get_layer_copy_pipeline(dev, block_B, &layout, &pipeline);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   struct nvk_meta_save_compute save;
+   nvk_meta_begin_compute(cmd, &save);
+   disp->CmdBindPipeline(handle, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+
+   for (uint32_t r = 0; r < info->regionCount; r++) {
+      const VkImageCopy2 *region = &info->pRegions[r];
+      const VkExtent3D extent_el =
+         vk_image_extent_to_elements(&src->vk, region->extent);
+      const VkOffset3D src_off =
+         vk_image_offset_to_elements(&src->vk, region->srcOffset);
+      const VkOffset3D dst_off =
+         vk_image_offset_to_elements(&dst->vk, region->dstOffset);
+      const uint32_t layer_count =
+         vk_image_subresource_layer_count(&src->vk, &region->srcSubresource);
+
+      for (uint32_t l = 0; l < layer_count; l++) {
+         VkImageView src_view, dst_view;
+         result = nvk_meta_layer_view(cmd, info->srcImage, view_format,
+                                      VK_IMAGE_USAGE_SAMPLED_BIT,
+                                      region->srcSubresource.mipLevel,
+                                      region->srcSubresource.baseArrayLayer + l,
+                                      &src_view);
+         if (result == VK_SUCCESS)
+            result = nvk_meta_layer_view(cmd, info->dstImage, view_format,
+                                         VK_IMAGE_USAGE_STORAGE_BIT,
+                                         region->dstSubresource.mipLevel,
+                                         region->dstSubresource.baseArrayLayer + l,
+                                         &dst_view);
+         if (result != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, result);
+            break;
+         }
+
+         const VkWriteDescriptorSet writes[] = {
+            {
+               .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+               .dstBinding = 0,
+               .descriptorCount = 1,
+               .descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+               .pImageInfo = &(VkDescriptorImageInfo) {
+                  .imageView = src_view,
+                  .imageLayout = info->srcImageLayout,
+               },
+            },
+            {
+               .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+               .dstBinding = 1,
+               .descriptorCount = 1,
+               .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+               .pImageInfo = &(VkDescriptorImageInfo) {
+                  .imageView = dst_view,
+                  .imageLayout = info->dstImageLayout,
+               },
+            },
+         };
+         disp->CmdPushDescriptorSetKHR(handle, VK_PIPELINE_BIND_POINT_COMPUTE,
+                                       layout, 0, ARRAY_SIZE(writes), writes);
+
+         const struct nvk_meta_layer_copy_push push = {
+            .src_offset_el = { src_off.x, src_off.y },
+            .dst_offset_el = { dst_off.x, dst_off.y },
+            .extent_el = { extent_el.width, extent_el.height },
+         };
+         disp->CmdPushConstants(handle, layout, VK_SHADER_STAGE_COMPUTE_BIT,
+                                0, sizeof(push), &push);
+         disp->CmdDispatch(handle, DIV_ROUND_UP(extent_el.width, 16),
+                           DIV_ROUND_UP(extent_el.height, 16), 1);
+      }
+   }
+
+   nvk_meta_end_compute(cmd, &save);
+}
