diff --git a/src/gallium/targets/dri/meson.build b/src/gallium/targets/dri/meson.build
index 17359f20bc29b5663f2bd95a0e544b32f720024a..d41dbd92e0f4060d8d70c2d7fcc7e19d39f445cf 100644
--- a/src/gallium/targets/dri/meson.build
+++ b/src/gallium/targets/dri/meson.build
@@ -33,7 +33,13 @@ if with_ld_dynamic_list
   gallium_dri_link_depends += files('../dri.dyn')
 endif
 
-if get_option('unversion-libgallium') or with_platform_android
+if with_platform_android
+  # Android loads EGL drivers by soname into one namespace (sphal), where the
+  # image may already ship its own Mesa's libgallium_dri.so. A suffixed EGL
+  # build gets a suffixed libgallium too, so the two never resolve to each
+  # other (libEGL_<s>.so / libGLESv*_<s>.so NEED libgallium_dri<s>.so).
+  libgallium_name = 'gallium_dri' + get_option('egl-lib-suffix')
+elif get_option('unversion-libgallium')
   libgallium_name = 'gallium_dri'
 else
   libgallium_name = 'gallium-@0@'.format(meson.project_version())
